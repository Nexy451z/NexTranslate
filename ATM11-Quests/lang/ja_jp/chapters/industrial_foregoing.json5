  "quest.55820773BDD5319D.quest_desc": [
    "&aインダストリアルフォーゴーイング&fへようこそ！"
  ],
  "quest.418E57E34FFC19E1.quest_subtitle": "ヴォイドマイナー",
  "quest.33532408B21A5378.quest_desc": [
    "Pitiful Generator は石炭のような燃料を使用して少量のFEを生成します"
  ],
  "quest.1823CC81D613892B.quest_desc": [
    "受動的なモブ -> Pink Slime が増えます",
    "敵対的なモブ -> 肉が増えます"
  ],
  "quest.57C4A0BAE739E903.quest_subtitle": "作業台？",
  "quest.485AFAE5BBEF2FC7.title": "動物",
  "quest.6C001E18093FC037.title": "植物",
  "quest.3514E9C1A8C7400C.quest_subtitle": "ティア: &b2",
  "task.6B17A0D9906E8C90.title": "AllRightsReserved",
  "quest.0E8647B8EB4AAC41.quest_desc": [
    "平和なモブ → より多くのピンクスライム\\n敵対的なモブ → より多くの肉"
  ],
  "quest.7B4AF35313D7D779.title": "&6最高級マシンフレーム",
  "quest.55820773BDD5319D.title": "インダストリアルフォーゴーイング",
  "quest.4DB5DD6E20619B4D.quest_desc": [
    "マシンを改良するために使用されます"
  ],
  "quest.0FAAE744E156D8EF.quest_desc": [
    "&b菌糸ブロックリアクター&rは、リアクターブロックの近くで同時に動作するすべての菌糸ブロックジェネレーターで構成され、合計で&a25MFE/t&rを生成します",
    "",
    "すべて良さそうですが、動作させるためにはいくつかのものを自動化する必要があります。各菌糸ブロックジェネレーターが何を消費するかを確認し、自動化してください。多くのものはシンプルですが、他のものはそうではありません... &o魔法解除菌糸ブロックジェネレーターを見て&r",
    "",
    "しかし、すべてを自動化した後は、一つにとどまる必要はありません。より多くのリアクターを作ることができます"
  ],
  "task.7058D3373DA87B34.title": "AllRightsReserved",
  "quest.57C4A0BAE739E903.quest_desc": [
    "Dissolution Chamber はより高度なマシンをクラフトするために使用します。\\n\\nクラフトに必要なアイテムと共に特定の液体を入れる必要があります。JEI で確認してください"
  ],
  "quest.2CCFEE98FE3B2E97.title": "ブロック",
  "quest.41E8550FC36ABCA5.title": "インフィニティツール",
  "quest.55820773BDD5319D.quest_subtitle": "ティア: &a1",
  "quest.418E57E34FFC19E1.title": "レーザードリル（ヴォイドマイナー）",
  "quest.4C366515E3CCB0B2.quest_desc": [
    "チューブを通した肉、美味しいです"
  ],
  "quest.0BCCDE24D378F260.title": "&dアドバンスドマシンフレーム",
  "quest.690CFF61CE787D43.quest_desc": [
    "プラスチックは &bIndustrial Foregoing&r のメインリソースです。これで非常に便利なマシンにアクセスできるようになりました！"
  ],
  "quest.3E6706BC4C318A40.quest_desc": [
    "下水道は下水を作るために使用され、その下水は肥料を作るために使用されます"
  ],
  "task.391AB5CA0E5C35FD.title": "ラテックス？うん？",
  "quest.5FE631066CAB7397.quest_desc": [
    "モブを簡単に捕まえて運ぶために使用します"
  ],
  "quest.540B857F043C24D5.title": "バイオパワー",
  "quest.0E8647B8EB4AAC41.title": "ピンクスライム\\\\\\\\&リキッドミート",
  "quest.6FF04DD735346BED.quest_desc": [
    "ラテックスをドライラバーに変換します"
  ],
  "quest.339DF320DDCAD98B.title": "アイテム\\\\\\\\&液体トランスポート",
  "quest.1BA3D15FFE7DBE59.title": "ラテックスとプラスチック？ね？",
  "quest.1BA3D15FFE7DBE59.quest_desc": [
    "&bインダストリアルフォーゴーイング&rへようこそ、このMODの主要なリソースの一つは&fラテックス&rです。それはマシンフレームを作るために使用され、それは...まあ...マシンやアップグレードを作るために必要です",
    "",
    "&oJEIはあなたの友達です&r",
    "",
    "ラテックスの作成は非常にシンプルです、&a液体エクストラクター&rは&6原木&rからラテックスを抽出します（アカシアが最も多く提供します）",
    "",
    "------------------------",
    "",
    "プラスチックの作り方について：プラスチックはドライラバーを溶かして作られます - ドライラバーは&aラテックスプロセッシングユニット&rでラテックスから作られます",
    "",
    "&b基本的にラテックス -> ドライラバー -> プラスチックです。&r"
  ],
  "quest.427C3AFC0FF131CD.title": "液体",
  "quest.321FA7348E532F4E.title": "Latex",
  "quest.418E57E34FFC19E1.quest_desc": [
    "提案: Wither-Proof Glass のようなものを使用してください"
  ],
  "quest.540B857F043C24D5.quest_desc": [
    "バイオリアクターは Biofuel Generator で作られたバイオ燃料を使用して FE を生成します"
  ],
  "quest.1BA3D15FFE7DBE59.quest_subtitle": "ラテックスとプラスチック？ね？",
  "quest.3CB7884B7B32CF00.quest_desc": [
    "最初の&bエーテルガス&rを手に入れるのは怖いでしょう",
    "&bエーテルガス&rは、&0ウィザー&rを掘削して、&5パープルレンズ&rを使用した液体ドリルで作られます",
    "",
    "しかし心配しないでください、インダストリアルフォーゴーイングにはそのタスクを助けるためのマシンがあります：&4ステーシスチャンバー&r - このマシンは上にあるものを3x3エリアでその場に凍結しますので、そこにウィザーをスポーンさせるのは安全です",
    "",
    "&c電力が切れないことを願いますが、もし切れたら...まあ...ウィザーと戦う準備をしておいてください&r"
  ],
  "task.1F1A69738DE70DB6.title": "菌糸ブロックリアクター、ね？",
  "quest.2F69010E1FA2787D.quest_desc": [
    "これらのクエストは &6AllTheModsスタッフ &rまたは &2コミュニティ寄与者 &rによって AllTheModsモッドパック 内での使用目的のために作成されました。\\n\\nすべての&6AllTheMods&rパックは &eAll Rights Reserved &r（著作権留保）ライセンス下のため、これらのクエストは &6AllTheModsチーム &rにより公式に配布されていない公開パッケージにおいて、明示的な許可なく本クエストを使用することは禁止されています。\\n\\nこのクエストは意図的に非表示になっています。クエストが見えている場合は編集モードになっています。"
  ],
  "quest.0FAAE744E156D8EF.quest_subtitle": "マイセリウムリアクター？",
  "quest.0EA9E52B67B533DF.quest_desc": [
    "溶かすとプラスチックが得られます。これはインダストリアルフォーゴーイングの主要なリソースです"
  ],
  "quest.2CCFEE98FE3B2E97.quest_desc": [
    "特にラテックスの自動化に便利な、ブロックの設置・破壊を自動化します"
  ],
  "task.38E166AC8F55D42E.title": "アップグレード",
  "quest.3027584AA6138E6D.title": "コンベヤー挿入＆抽出",
  "quest.0BCCDE24D378F260.quest_subtitle": "ティア: &d3",
  "quest.0EC2053B191C55C6.quest_desc": [
    "木からラテックスを抽出します",
    "",
    "許容される木とラテックスの量についてはJEIをチェックしてください。最適な木はアカシアです"
  ],
  "quest.3514E9C1A8C7400C.title": "&bシンプルマシンフレーム",
  "quest.06F84E2C484FAC5B.quest_desc": [
    "丸石ジェネレーターって聞いたことがある？マテリアルストーンワークファクトリーはそれと同じように動くけど、さらに上を行くマシンなんだ。石を砕いて砂利や砂、シリコンにしたり、石に精錬したり、黒曜石を作ったり、あとはJEIにこのマシンのレシピとして表示されるものなら何でもできるよ。"
  ],
  "quest.0B35172E47705205.quest_desc": [
    "そう、&bIndustrial Foregoing&r にも鉱石処理があるよ。これは &6液体ミート&r を使って鉱石を生の鉱石ミートに変換するんだ。僕は鉱石の専門医じゃないから、この生の鉱石ミートをどう扱えばいいのか正確にはわからないや。たぶんファーメンテーションステーションに渡せばいいんじゃないかな？"
  ],
  "quest.0B35172E47705205.quest_subtitle": "鉱石処理: ステップ1",
  "quest.0D2DD9AA960843A3.quest_desc": [
    "モブディテクターは作業エリア内のエンティティを検出し、その背面に、作業エリア内のエンティティ数に等しい強度のレッドストーン信号を出力するよ。\n\nこのマシンはレンジアドオンに対応しているよ。"
  ],
  "quest.15551AC6C68E12E0.quest_desc": [
    "要するに &bIndustrial Foregoing&r のスポナーだね。&aエッセンス&r と、モブ監禁ツールに入れたモブを使って、そのモブのコピーをスポーンさせるんだ。\n\nボスや、スポナーに入れられない*モブは、モブデュプリケーターでもブラックリストに入れられているよ。\n\n*&8いくつかの例外を除き、詳細なツールチップ（F3 + H）を有効にした状態でスポーンエッグ上でSHIFTを押すと、Mob Duplicator Blacklist タグがあるか確認できるよ。"
  ],
  "quest.1684D52FDAAC894B.quest_desc": [
    "例の「鉱石医者じゃない」彼を覚えてる？ウォッシングファクトリーが彼の代役を務めてくれて、ウォッシングファクトリーから出た生の鉱石ミートを処理して、発酵鉱石ミートに変えてくれるんだ。このマシンには4つのモードがあるよ。\n\n1. 鉱石処理速度2倍、処理時間5秒。\n2. 鉱石処理速度3倍、処理時間45秒。\n3. 鉱石処理速度4倍、処理時間120秒。&#FF69B4ピンクスライム&r を触媒として使う。\n4. 鉱石処理速度5倍、処理時間300秒。&bエーテルガス&r を触媒として使う。"
  ],
  "quest.1684D52FDAAC894B.quest_subtitle": "鉱石処理: ステップ2",
  "quest.1C0ABA26D63858DF.title": "まだここにはない",
  "quest.1F66CDC9799B5DEC.quest_desc": [
    "&bIndustrial Foregoing&r のマシンをほとんどのレンチで回転できなくて、僕はイライラしていたんだ。そこで、&bIF&r のマシンを回転できるレンチを、見つけられた限り全部リストアップしてみたよ。検証は主にレーザードリルで行ったから、結果も主にそれに基づいているよ。他のマシンでは動かないレンチもあるかもしれない。\n\nこのクエストのタスクをクリックすると、有効なレンチを全部確認できるよ。"
  ],
  "quest.224C07AC71C5F40E.quest_desc": [
    "作業エリア内の植物に &l骨粉&r か &#8B4513肥料&r を散布するよ。同じ作物に &#8B4513肥料&r を、その作物が &l骨粉&r を受け付けなくなるまで散布し続けてから、次の植物に移るんだ。つまり、&eヒマワリ&r のように常に &l骨粉&r を受け付ける植物や、最終成長段階に達しない植物があると、マシンがそこで止まってしまうことがあるよ。\n\nこのマシンはレンジアドオンに対応しているよ。"
  ],
  "quest.22702838FC507A2E.quest_desc": [
    "ハイドロポニックベッドはエネルギーと &9水&r を使って、その上に植えられた作物や苗木を育てるよ。想像できるほぼどんな作物にも対応しているんだ。&bエーテルガス&r を供給すると、マシンが自動で作物を収穫し、その結果を内部バッファに格納してくれるよ。これはハイドロポニックシミュレーションプロセッサ用の作物データを集めるのにも使えて、それをシミュレーテッドハイドロポニックベッドで使えるんだ。\n\n苗木を育てるにはスペースが必要だよ。"
  ],
  "quest.2580135392DEF522.quest_desc": [
    "標準のハイドロポニックベッドはラグすぎると感じたことはない？ソウルサージを十分に詰め込めない？そんな君にシミュレーテッドハイドロポニックベッドを紹介しよう。これはハイドロポニックシミュレーションプロセッサと種や苗木を使って、好きな作物を…仮想的に育てるんだ。これなら &9水&r も &bエーテルガス&r も必要ないよ。しかも、ハイドロポニックシミュレーションプロセッサは作物を育てるほど時間とともに性能が上がっていくよ。ただし、シミュレーテッドハイドロポニックベッドではその伸びは遅いけどね。\n\nプロセッサを最大化しようとなんて思わなくていいよ。気が遠くなるほど長い時間がかかるから。間違いなく、僕が Ender IO のクエストを作るよりずっと長いよ。"
  ],
  "quest.2580135392DEF522.quest_subtitle": "作物版HNN？",
  "quest.2580135392DEF522.title": "シミュレーテッドハイドロポニックベッド",
  "quest.2782EA80C1C74EBD.quest_desc": [
    "モブクラッシャーは作業エリア内のモブを &l削除&r して、そのモブのドロップを回収するよ。さらに、そのモブが得るはずだった &a経験値&r を &aエッセンス&r に変換してくれるんだ。オプションで、本来得られる経験値を代わりにモブクラッシャーのドロップ増加に使うこともできるよ。\n\nボスやスポナーに入れられないモブは、モブクラッシャーでは「ブラックリスト」扱いになるんだ。&l削除&r される代わりに、1回の動作につき75ダメージを受けるよ。\n\nこのマシンはレンジアドオンに対応しているよ。"
  ],
  "quest.2782EA80C1C74EBD.quest_subtitle": "エンドレスゲートウェイクラッシャーも",
  "quest.287B47E27EBC2C18.quest_desc": [
    "エンチャントファクトリーは、要するに自動エンチャントテーブルだよ。装備や本と &aエッセンス&r を渡すと、そのアイテムにランダムなエンチャントを付与してくれるんだ。このマシンは真上に置いたタンクから液体を取り込めるから、装備や本により良いエンチャントが付く可能性を高められるよ。"
  ],
  "quest.28B3591BFC0FA08B.quest_desc": [
    "ウィザービルダーは、その名の通りウィザーを組み立てるよ。ATM Star に必要な Wither's Compass の一部なんだ。\n\n&8ウィザーに吹き飛ばされないように、ウィザービルダーをウィザープルーフガラスで囲っておくといいかもね。"
  ],
  "quest.2DC012EF21FB359E.quest_desc": [
    "エンチャントエクストラクターは、装備からエンチャントを自動で剥がせるよ。エンチャントを本に移すか、&aエッセンス&r に変換するかを選べるんだ。"
  ],
  "quest.2E8E292ED596A104.quest_desc": [
    "レーザーレンズを使うと、鉱石レーザーを特定の色の鉱石にもっと集中させられるよ。どのレンズがどの種類の鉱石に最適かはJEIで確認してね。液体レーザーで生成できる液体の種類も、これで決まるんだ。"
  ],
  "quest.321FA7348E532F4E.quest_desc": [
    "ラテックスは乾燥ゴムを作るのに使う液体だけど、溶解チャンバーでいくつかのものに使うこともできるよ。"
  ],
  "quest.339DF320DDCAD98B.quest_desc": [
    "トランスポーターは、1ブロック離れたインベントリ間でアイテムや液体を輸送できるよ。抽出側と挿入側の両方にトランスポーターが必要なんだ。モードを切り替えるには、中央部分を右クリックしてね。\n\n同じブロックに複数の種類のトランスポーターを設置できるよ。これらはアドオンでアップグレードできるんだ。スピードは転送速度を、効率は転送量を増やしてくれるよ。"
  ],
  "quest.34AA079FFAFC64BD.quest_desc": [
    "&bIndustrial Foregoing&r の鉱石処理シリーズの最終ステップ、フルイドシービングマシンだよ。これは砂を使って発酵鉱石ミートから有用な部分をろ過し、ダストを取り出してくれるんだ。そのダストは好きに使っていいよ。精錬してもいいし、合金に混ぜてもいい。"
  ],
  "quest.34AA079FFAFC64BD.quest_subtitle": "鉱石処理: ステップ3",
  "quest.3924975B48F5A482.quest_desc": [
    "&#27AEB9ソウルパイプ&r を持ち歩きたくないなら、代わりにAE2を使う手もあるよ。\n\n&#27AEB9ソウルレーザーベース&r の上にMEストレージバスを置けば、MEネットワークから中の &#27AEB9ソウル&r にアクセスできるようになるんだ。MEインターフェースに保持を要求することもできるよ。"
  ],
  "quest.3924975B48F5A482.title": "ソウルプライドエナジスティックス",
  "quest.3AFDE3396861A944.quest_desc": [
    "エンチャントアプリケーターは自動金床だよ。エンチャントの本を装備に自動で適用してくれるんだ。&a経験値&r の代わりに &aエッセンス&r を使うよ。このマシンは真上に置いたタンクから液体を取り込めるから、装備により良いエンチャントが付く可能性を高められるんだ。"
  ],
  "quest.3E6706BC4C318A40.quest_subtitle": "肥やし場から採れたての、君の不気味さ",
  "quest.408203C29BAABA44.quest_desc": [
    "たった1つの用途にしか使わないんだ。"
  ],
  "quest.41E8550FC36ABCA5.quest_desc": [
    "Infinity Tools は、ほぼ無限に充電できることからそう呼ばれているよ。ツールのティアを上げると、そのツールに特別な特典が付くんだ。中に &5バイオ燃料&r を入れておくと、使用時に電力の代わりに燃料を消費して、より効率的になるよ。\n\nティアは7段階：\nPoor\nCommon\nUncommon\nRare\nEpic\nLegendary\nArtifact\n\n各 Infinity Tool についてもっと知りたいなら、Industrial Foregoing のマニュアルをチェックしてね（1つのクエストでそんなにたくさんのインフィニティツールを扱いたくないからね）！"
  ],
  "quest.483E93500E645835.quest_desc": [
    "少なくともインゴットよりは多用途だよ。"
  ],
  "quest.485AFAE5BBEF2FC7.quest_desc": [
    "アニマルランチャーは &zSheep&r の毛を刈ったり、&8C&ro&8w&rs の乳を搾ったりするよ。\n\nアニマルフィーダーは動物に餌を与えて、繁殖できるようにするんだ。\n\nアニマルベビーセパレーターは子供をその後ろにテレポートさせるよ。\n\nこれらのマシンはすべてレンジアドオンに対応しているよ。"
  ],
  "quest.4A8C60412E59E971.quest_desc": [
    "このマシンはエンチャント済みのアイテムとエンチャントされていないアイテムを選別できるよ。エンチャント済みアイテムは上のインベントリに、エンチャントされていないアイテムは下のインベントリに入るんだ。"
  ],
  "quest.4F3EF1574F31A7E2.quest_desc": [
    "ステイシスチャンバーは、作業エリア内のモブをその場に固定できるよ。ステイシス状態のモブはチャンバーによって回復もされるんだ。もっと回復が必要？アドオンを導入しよう！"
  ],
  "quest.538186D01429F05F.quest_desc": [
    "このクエストでは、AE2を使って &cポーションブリュワー&r を自動化する方法に焦点を当てるよ。まずは次のような設備を組んでね：",
    "{image:atm:textures/questpics/industrialforegoing/potionbrewerdemonstration.png width:175 height:200 align:center}",
    "（クリエイティブエネルギーセルは、メインネットワークの代用として置いているよ）",
    "{@pagebreak}",
    "&cポーションブリュワー&r に &1水&r と &6ブレイズパウダー&r を入れるには、&9エクスポートバス&r か &9インターフェース&r が必要だよ。&6ブレイズパウダー&r は燃料として使われるんだ。まだボトルは入れないでね。ネットワークが水入り瓶でいっぱいになっちゃうから。",
    "{@pagebreak}",
    "次に用意するのは",
    "&5アドバンスドパターンプロバイダー&r だよ。使い方をもっと詳しく知りたいなら、Extended & Advanced AE の章をチェックしてね。次に、パターンをエンコードする必要があるんだ。例えば、Modular Bees の Royal Treats 用に &4回復のポーション&r を醸造するとしよう。パターンはこうエンコードするよ：ガラス瓶3個、ネザーウォート1個、きらめくスイカの薄切り1個で、&4回復のポーション&r を3個生成する、という具合にね。ここでは &5アドバンスドプロバイダー&r の特別な能力を2つとも使うよ。1つ目は、アイテムを特定の面に送れる能力だね。これを使ってガラス瓶をマシンの上面（TOP）に送るんだ。パターンのエンコードには &5アドバンスドパターンエンコーダー&r を使うよ、こんな風に：",
    "{image:atm:textures/questpics/industrialforegoing/advanced_pattern.png width:200 height:100 align:center}",
    "{@pagebreak}",
    "次に、&5アドバンスドプロバイダー&r でフィルター付きインポートを有効にする必要があるよ。こうすると &5アドバンスドプロバイダー&r は、現在進行中のクラフトジョブに一致するアイテムだけを受け入れるようになるんだ。つまり、ポーションを早まって受け取ってしまうことがなくなるよ。同じプロバイダーを使うような大規模なクラフトジョブでは、処理アドオンを追加して補助するのもいいね。\n\n最後に、ポーションブリュワーの各面を次のように設定してね：",
    "{image:atm:textures/questpics/industrialforegoing/blaze_input.png width:125 height:100 align:center}",
    "{image:atm:textures/questpics/industrialforegoing/bottle_input.png width:125 height:100 align:center}",
    "{image:atm:textures/questpics/industrialforegoing/brewing_input.png width:125 height:100 align:center}",
    "{image:atm:textures/questpics/industrialforegoing/output.png width:125 height:100 align:center}",
    "&9インターフェース&r 方式を使う場合は、各面を次のように設定してね：",
    "{image:atm:textures/questpics/industrialforegoing/blaze_input_for_interface.png width:125 height:100 align:center}",
    "{image:atm:textures/questpics/industrialforegoing/water_for_interface.png width:125 height:100 align:center}",
    "{@pagebreak}",
    "オプションで、&5アドバンスドプロバイダー&r と &cブリュワー&r の間にトランスファーラベルを置くこともできるよ。\n\nこの構成がまだよくわからない、あるいは動画で見たいという場合は、ChosenArchitect の動画をここにリンクしておいたからチェックしてね：",
    "{\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://youtu.be/DOW4xkxqp6g?si=paZ2xFKyycPumqaS&t=427\"},\"color\":\"blue\",\"text\":\"動画リンクはこちら\",\"underlined\":true} "
  ],
  "quest.538186D01429F05F.quest_subtitle": "AE2を使う",
  "quest.538186D01429F05F.title": "ポーションブリュワーの自動化",
  "quest.605A5AC65BC7E864.quest_desc": [
    "マリンフィッシャーは自動で釣りができるよ。魚や宝物、エンチャントの本、その他いろいろなものを釣り上げられるんだ。でも蜂は釣れないから、それは手動で釣ってね。\n\n3x3（またはそれ以上）の &9水&r プールの上に設置する必要があるよ。"
  ],
  "quest.616CFD4078D67B51.quest_desc": [
    "コンベアは物を輸送するもう1つの手段だよ。アイテム、エンティティ、さらには液体まで扱えるんだ。コンベアアップグレードを使えばワールドと干渉させることもできるよ。\n\nコンベアはグロウストーンで強化して速くしたり、プラスチックでアイテムを拾わないようにしたりできるよ。"
  ],
  "quest.65C147F5282E8FCD.quest_desc": [
    "インフィニティチャージャーは、Infinity Tools を充電するのに最適な選択肢だよ。&l大量&r のFEを蓄えられて、Infinity Tools にぴったりなんだ。\n\n他のものも充電できるよ。"
  ],
  "quest.6C001E18093FC037.quest_desc": [
    "プラントギャザラーは作業エリア内の植物を収穫するよ。収穫した植物からは &#5919B6スラッジ&r が得られることがあり、これはスラッジリファイナーで使えるんだ。&bエーテルガス&r を供給すると、プラントギャザラーは作物を自動で植え直してくれるよ。\n\nプラントソワーは作物や苗木を自動で植えるよ。9つの色分けされたインベントリスロットがあり、プラントソワー上部の色付きマーキングに対応しているんだ。マシンの作業エリアは9つの区画に分かれていて、それぞれが各インベントリスロットに対応しているよ。\n\nどちらのマシンもレンジアドオンに対応しているよ。"
  ],
  "quest.6E131A32A96D7BF5.quest_desc": [
    "スラッジリファイナーは &#5919B6スラッジ&r を使って、土や砂利、ソウルサンド…などなど…を生産できるよ。残りはJEIで確認してね。"
  ],
  "quest.79D48F8F31B152C3.quest_desc": [
    "&bIndustrial Foregoing &#27AEB9Souls&r は、他の機械を加速させるためのマシンを追加するよ。\n\nその中心となるのが &#27AEB9ソウルレーザーベース&r で、ウィザーからエーテルガスを抽出するフルイドレーザーベースと似た仕組みで動くんだ。&9ブルーレーザーレンズ&r を使って &#27AEB9ウォーデン&r から &#27AEB9ソウル&r を抽出し、それは &#27AEB9ソウルパイプ&r で取り出したり、二大デジタルストレージMOD（AE2とRS）で利用したりできるよ。この &#27AEB9ソウル&r は &#27AEB9ソウルサージ&r によって使われ、ブロックを加速させるんだ。\n\n&#27AEB9ウォーデン&r から &#27AEB9ソウル&r を抽出するのは、その生物にとって &4&l苦痛&r な工程で、ダメージを受け、最悪の場合死んでしまうこともあるんだ。ステイシスチャンバーを強くおすすめするよ。特に回復を速くするアップグレードと一緒ならね。",
    "{@pagebreak}",
    "床と &#27AEB9ソウルレーザーベース&r の間に3ブロックの隙間を確保してね。こんな感じに：",
    "{image:atm:textures/questpics/industrialforegoing/soul_laser_gap.png width:100 height:100 align:center}",
    "さらに、&#27AEB9ウォーデン&r をステイシス状態にする前に、完全に出現していることを確認してね。"
  ],
  "quest.79D48F8F31B152C3.quest_subtitle": "とにかく速く！",
  "quest.79D48F8F31B152C3.title": "&bIndustrial Foregoing &#27AEB9ソウル",
  "quest.7CB4D47ABC295B92.quest_desc": [
    "ポーションを醸造するよ。通常の醸造台と同じように、燃料としてブレイズパウダーが必要で、ボトルを使うんだ。でも醸造台と違って、ボトルに水を自動で補充できるよ。\n\n他のクエストのようにマシンの簡単な概要を説明する代わりに、このマシンの自動化構成は別のクエストで紹介するね。なにせかなりクセがあって、ところどころ直感的じゃないからね。"
  ],
  "quest.7E39FB9F3E973009.quest_subtitle": "いや、これはMekanismの化学物質じゃないよ、Wither Milk だよ",
  "quest.7EA218A489641684.quest_desc": [
    "Buuz135（&bIndustrial Foregoing&r の開発者）は、ソウルを保管する資源にしたくなかったんだ。でも Ultramega がなんとか保管できるようにしちゃったよ。\n\nヒント：レギュレーターアップグレードを使って、エクスポーターが接続されたソウルパイプにソウルを全部流し込んでしまうのを防ごう。"
  ],
  "quest.7EA218A489641684.quest_subtitle": "Buuzはこれを望んでいなかった",
  "quest.7EA218A489641684.title": "ソウルの保管？"
}
