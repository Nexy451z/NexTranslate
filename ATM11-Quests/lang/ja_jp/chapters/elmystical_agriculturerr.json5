  "quest.7A103577EAE7B3F1.title": "&6覚醒スプリミウム",
  "quest.19AAC139177442C1.quest_subtitle": "ティア: &63",
  "quest.62D572BAB055F56F.quest_subtitle": "ティア: &e1",
