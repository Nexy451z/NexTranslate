{
  "quest.53518D4ED99A242F.quest_subtitle": "設備をおしゃれに見せたい？",
  "quest.36D72D759C4E8823.quest_subtitle": "最大: 1",
  "quest.64D34A6C3487C5DF.quest_subtitle": "ワイヤレス圧力！",
  "quest.5AEE86EB39FD4087.title": "熱の生成",
  "quest.0D50BDEFA0319EA1.quest_desc": [
    "完成品が出力チェストに投入されます。"
  ],
  "quest.2DE7CC686B56881F.quest_desc": [
    "Mekanismの放射線から身を守ります。"
  ],
  "quest.40F634AC38F42B88.title": "圧力の移動",
  "quest.63F6F4EBCEB914B0.quest_desc": [
    "&3圧力チャンバー&rは&3圧力チャンバーの壁&rで作る重要なマルチブロックです(面は&3圧力チャンバーのガラス&rで置き換え可能)。3x3x3から5x5x5まで作れます。このクエストには5x5x5に必要なブロックが必要です。\n\n使用するには、先ほど作った&3圧力チューブ&rで&3圧力チャンバーバルブ&rに圧力を送ります。バルブにセキュリティアップグレードを入れるのを忘れずに。&lレシピごとに必要な圧力が異なります&r。\n\n圧力チャンバーへのアイテム入出力も必要で、それには&3圧力チャンバーインターフェース&rを使います。外側が青ならアイテム入力用、金色なら出力用です。任意の面に1つずつ設置してください。"
  ],
  "quest.5A9D6672385D3D82.quest_subtitle": "ラピスの節約",
  "quest.3D819550074CA376.quest_subtitle": "常に必要",
  "quest.6B1C06C753C10E44.quest_desc": [
    "&3ロジスティクスコンフィギュレーター&rはロジスティックフレームとトランスファーガジェットの設定に使えます。"
  ],
  "quest.13F68CA518CD287C.title": "ディーゼル",
  "quest.43EF5513A1C52A37.quest_subtitle": "名前が長いほど良い",
  "quest.4F5348D0C83C3B0D.quest_subtitle": "太陽のセル",
  "quest.64E2E05B228EA53E.quest_subtitle": "まったく新しいレベル！",
  "quest.3E16CF590C911129.title": "圧力の生成",
  "task.49A8320F9EA7F4BD.title": "圧縮鉄の自動化",
  "quest.230463E830D6FFEB.quest_desc": [
    "プラスチックができたので、次は完成PCBです。まず圧力チャンバーで&3空のPCB&rを作りましょう。"
  ],
  "quest.0D5015B8FF482D0A.quest_subtitle": "1日配達はあるのかな？",
  "quest.495DCA49B4E80852.quest_desc": [
    "&3ミニガン&rは圧力と弾薬が必要な銃です。詳細はツールチップを確認してください。"
  ],
  "quest.2DE7CC686B56881F.quest_subtitle": "最大: 1",
  "quest.7D81F2381516204D.title": "トランジスタ",
  "quest.0D2F5CC96269F9E3.quest_subtitle": "エッチングの時間です！",
  "quest.2CC56A4F06E53307.title": "UVで充電",
  "quest.3334D15766A47A46.title": "PCBの自動化",
  "quest.5A0860631323B5E3.quest_desc": [
    "&3小麦粉&rで作られます。サーモンの天ぷらとサワードウブレッドに使えます。"
  ],
  "quest.6D124ACF4AE80490.quest_desc": [
    "マイクロミサイルなら遠くから爆発を撃てます！もう誰も逃げられません！\n\n&6ATMスター&rのクラフトにも必要です。"
  ],
  "quest.7395B41685F4BC1A.quest_subtitle": "電力 = 圧力",
  "quest.5D71ED16FD4E725A.quest_subtitle": "最大: 1",
  "quest.7395B41685F4BC1A.title": "電力から圧力へ",
  "quest.461C8F1E88AA58D9.quest_desc": [
    "PneumaticCraft液体のバケツ版を使うレシピに使用できます。\n\n&3液体タンク&rを別の&3液体タンク&rの上に置き、レンチで接続すると1つの大きなタンクになります。\n",
    "{image:pneumaticcraft:textures/patchouli/small_tanks.png width:250 height:250 align:center fit:true}"
  ],
  "quest.3E16CF590C911129.quest_desc": [
    "&3エアコンプレッサー&rは簡単に圧力を作る手段です。燃えるアイテムを入れるだけで魔法が起きます！(最初は最低3台作ることをおすすめします)"
  ],
  "quest.482E558BCFEE6B7E.quest_subtitle": "これを踏む以上の痛みはない",
  "quest.4B4F5341D6DBDD19.quest_subtitle": "最大: 1",
  "quest.122EDEC12C9A05D2.quest_subtitle": "簡単な解決策があればいいのに…",
  "quest.68F92455A9483AD6.quest_subtitle": "エリトラを使う方が難しいと思った？",
  "quest.54169B69725C49DF.quest_subtitle": "ついに！",
  "quest.122EDEC12C9A05D2.title": "爆発の防止？",
  "quest.2801B7B6BF61E978.quest_desc": [
    "&3ケロシン&rはガソリンの原料やケロシンランプの燃料に使えます。"
  ],
  "quest.762B8309E1A31B99.quest_desc": [
    "アップグレードごとに防具+0.5と防具強度+1が追加されます。"
  ],
  "quest.1427B3AB09510D20.quest_subtitle": "やりましたね！",
  "quest.0D31CD79BE6CC8D2.title": "酵母",
  "quest.7177E49BF9ECA5CF.quest_desc": [
    "&3熱コンプレッサー&rは熱で圧力を生成します！片側に熱いもの、反対側に冷たいものを置くと圧力が生まれます。",
    "",
    "{image:pneumaticcraft:textures/patchouli/thermal_compressor.png width:100 height:100 align:left fit:true}"
  ],
  "quest.2338E5269CA23C91.quest_subtitle": "これが最高のビット",
  "quest.002163B909070CF8.quest_desc": [
    "特定のブロック/液体の詳細を壁越しでも確認できます。\n",
    "{image:atm:textures/questpics/pneumaticcraft/block_tracker.png width:150 height:150 align:center}"
  ],
  "quest.5E71F8A046C60346.title": "発電",
  "quest.26BEA64C80ECE1A6.quest_desc": [
    "各&3ロジスティックフレーム&rは異なる自動化に使えます。"
  ],
  "quest.7953C87C488A2AF7.quest_desc": [
    "アイアンマンのように飛べます。\n\nこのアップグレードはブーツに1レベルしか入れられません。レベルが上がるほど多くの圧力を使います。\n\n作るだけでなく、使いましょう。"
  ],
  "quest.61AD2207E770CD7F.quest_desc": [
    "より遠くからアイテムと経験値を拾えます。"
  ],
  "quest.75D3F3C1D4A3EAA2.title": "熱の移動",
  "quest.5C7D9BCDF19B86BD.quest_subtitle": "安全！",
  "quest.72C09FD89C28B1EC.quest_subtitle": "ようやく進み始めた",
  "quest.4C0D00B5305117A1.quest_desc": [
    "&3セントリータレット&rは設置して、範囲内のMobやプレイヤーを攻撃するように設定できます。ミニガン弾薬が必要です。",
    "",
    "{image:pneumaticcraft:textures/patchouli/sentry_turret.png width:100 height:100 align:left fit:true}"
  ],
  "quest.2E8F851A4E98F741.quest_subtitle": "圧縮鉄マン",
  "quest.7D81F2381516204D.quest_subtitle": "完成PCBに必要",
  "quest.7386A8433698946C.quest_subtitle": "最大: 1",
  "quest.0D9560C8E247F9E7.quest_subtitle": "最大: 1",
  "quest.04BE9F63E6003475.quest_desc": [
    "&3LPG&rは溶融プラスチックの作成に使えます。"
  ],
  "quest.7770F0D62457096D.quest_desc": [
    "このクエストではドローンを扱いませんが、ドローンは素晴らしいです！使いたい場合は調べてみてください。"
  ],
  "quest.64E2E05B228EA53E.quest_desc": [
    "&3アドバンスド圧力チューブ&rは最高の圧力チューブで、20バールに耐えられます！\n\nそれ自体も優秀ですが、さらに凄いレシピにも使えます。"
  ],
  "quest.46BE62C20C720D10.quest_subtitle": "最大: 1",
  "quest.715B86DC82EA636B.title": "液体からの圧力",
  "quest.68F92455A9483AD6.title": "ジェットブーツ",
  "quest.681A3F31FB242555.quest_desc": [
    "&3エタノール&rはバイオディーゼルの作成に使えます。"
  ],
  "quest.5E71F8A046C60346.quest_desc": [
    "PneumaticCraftが発電と無関係だと誰が言った？\n\n&3ニューマチックダイナモ&rは圧力をFEに変換できます。仕組みはツールチップかPNC:Rで確認してください。"
  ],
  "quest.0AEAEA976ED0C470.quest_subtitle": "コードはどこ？",
  "quest.423B8DA485C1308C.quest_subtitle": "ガス、ガス、ガス",
  "quest.2801B7B6BF61E978.title": "ケロシン",
  "quest.482E558BCFEE6B7E.quest_desc": [
    "&3建設レンガ&rはクールな建材ですが、踏むと痛いので注意。もう一度クラフトすると滑らかになります。"
  ],
  "quest.0E65BE9460B74000.quest_desc": [
    "ロジスティックフレームは&3ロジスティクスモジュール&rに接続しないと動作しません。",
    "",
    "{image:pneumaticcraft:textures/patchouli/logistics_module.png width:100 height:100 align:left fit:true}"
  ],
  "quest.3CFE522A4B7CC2EC.quest_subtitle": "普通のチェストより上",
  "quest.68F92455A9483AD6.quest_desc": [
    "このクエストはジェットブーツを使った場合のみ表示されます。\n\nダメージを受けずにジェットブーツを使う方法はありません。試さないでください…"
  ],
  "quest.32C3E14578D48E6C.quest_desc": [
    "通常の&3圧力チューブ&rと同じですが、こちらは10バールの圧力に耐えられます。"
  ],
  "quest.602C3E88D96F8843.quest_desc": [
    "充電済みの空PCBをエッチングタンクにエッチング酸と熱と共に入れると&3未組立PCB&rが得られます。"
  ],
  "quest.74015945716FD10A.quest_subtitle": "設定可能なホッパー",
  "quest.31BCE63F5E016323.quest_desc": [
    "&3ソーラーコンプレッサー&rは日光で圧力を生成します。気温が高いほど多くの圧力を生みます。\n\nただし熱くなりすぎると故障し、修理が必要になるので注意してください。"
  ],
  "quest.7953C87C488A2AF7.quest_subtitle": "最大: 1",
  "quest.40924F0D64253A38.quest_subtitle": "消えた！",
  "quest.0672462DA3599484.quest_subtitle": "512,000mb",
  "quest.4FCC20D9F8F87B2F.quest_desc": [
    "&3ニューマチックレンチ&rはマシンやチューブを移動・破壊するのに使います。"
  ],
  "quest.461C8F1E88AA58D9.quest_subtitle": "32,000mb",
  "quest.40F634AC38F42B88.quest_subtitle": "どんな圧力？",
  "quest.3334D15766A47A46.quest_desc": [
    "レーザー組み立てプログラムを使うと&3未組立PCB&rの生産を加速できます。空のPCBを入力チェストに入れ、圧力を加えて待つだけです。"
  ],
  "quest.521656D425E2FDBA.quest_desc": [
    "ティアIIよりもさらに高速です。"
  ],
  "quest.7040CA41C0A3C2F2.title": "&9PCBブループリント",
  "quest.2338E5269CA23C91.quest_desc": [
    "&3ネザライトドリルビット&rは最高のドリルビットで、ダイヤモンドドリルビットよりも優れています。"
  ],
  "quest.325483DEB0C602F8.quest_desc": [
    "このクエストは&6AllTheModsスタッフ&rまたは&2コミュニティ貢献者&rがAllTheMods MODパック用に作成したものです。\n\nすべての&6AllTheMods&rパックは&eAll Rights Reserved&rライセンスのため、このクエストは&6AllTheModsチーム&rがリリースしたもの以外の公開パックで、明示的な許可なく使用できません。\n\nこのクエストは意図的に非表示です。表示されているなら編集モードです。"
  ],
  "quest.00D7BCC68D971A53.quest_subtitle": "最大: 1",
  "quest.2C5D78630C7AD57F.quest_desc": [
    "範囲を拡大し、使う対象によって効果が異なります。"
  ],
  "quest.65E2AF881709C896.quest_desc": [
    "必要になる最重要素材のひとつが&3強化石&rです。まず圧縮鉄と普通の石で32個作りましょう。"
  ],
  "quest.2E8F851A4E98F741.title": "ニューマチックアーマー",
  "quest.7395B41685F4BC1A.quest_desc": [
    "&3フラックスコンプレッサー&rは電力で大量の圧力を生成できます。FEを送り込むだけで生成が始まります。余剰FEがあるなら、これが最も簡単な圧力生成手段でしょう。"
  ],
  "quest.521656D425E2FDBA.quest_subtitle": "最大: 1",
  "quest.7BFC24607189B6D0.quest_subtitle": "最大: 1",
  "quest.22572456571C3F8D.quest_desc": [
    "&3充電モジュール&rは、向けたコンテナ内の加圧可能なものを減圧します。"
  ],
  "quest.39F142224D5210A9.quest_desc": [
    "&3バイオディーゼル&rは&3潤滑油&rと&3溶融プラスチック&rの作成に使えます。"
  ],
  "quest.5D7B34761E8FD212.quest_desc": [
    "&3静電コンプレッサー&rは落雷から大量の圧力を生成します。\n\n詳しくはJEIの「Information」タブを確認してください。\n",
    "{image:pneumaticcraft:textures/patchouli/electrostatic_compressor.png width:100 height:100 align:left fit:true}"
  ],
  "quest.61AD2207E770CD7F.quest_subtitle": "最大: 6",
  "quest.0D5015B8FF482D0A.title": "Amadron",
  "quest.54169B69725C49DF.quest_desc": [
    "液体プラスチックを地面に置くか、ヒートフレームを付けたチェストに保管すると&3プラスチックシート&rができます！"
  ],
  "quest.09BA45CBBFB4AE26.quest_subtitle": "常に必要",
  "quest.3F9CCCFEF4E84166.title": "熱生産の改善",
  "quest.002163B909070CF8.quest_subtitle": "最大: 1",
  "quest.0A912B2E2BE34920.quest_subtitle": "油の掘削",
  "task.13266875BDB5077D.title": "AllRightsReserved",
  "quest.40F634AC38F42B88.quest_desc": [
    "圧力を移動するには&3圧力チューブ&rが必要です。どんな圧力かって？クエストラインを進めれば用途が分かります。"
  ],
  "quest.0A912B2E2BE34920.quest_desc": [
    "原油は地表でも見つかりますが、掘削は大量の油を得るのに最適です。まず&3地震センサー&rで地下の油を探し、ドリルパイプを入れた&3ガスリフト&rで掘削します(圧力が必要です)。\n",
    "{image:pneumaticcraft:textures/patchouli/oil_pumping.png width:200 height:200 align:right fit:true}"
  ],
  "quest.0D5015B8FF482D0A.quest_desc": [
    "進行には&3Amadronタブレット&rで&3Amadron&rから注文する必要があります。使うにはチェストと液体タンクをShift右クリックし、リンクしたコンテナ(エメラルドなど)に通貨を入れて注文します。Amadroneが降りてきてお金を受け取り、別のAmadroneが注文品を届けます。",
    "",
    "{image:atm:textures/questpics/pneumaticcraft/amadron_drone.png width:300 height:150 align:center}"
  ],
  "quest.09BA45CBBFB4AE26.quest_desc": [
    "このMODの次の段階では&3組み立てライン&rの設置が必要です。&3組み立てライン&rの主要コンポーネントは&3アセンブリコントローラー&rです。\n\nここに圧力が供給されます。"
  ],
  "quest.6674270897997BF7.quest_desc": [
    "通常より高くジャンプでき、バネのように素早く移動できます。\n\nこのアップグレードはレギンスに1レベルしか入れられません。"
  ],
  "quest.00D7BCC68D971A53.quest_desc": [
    "近くの生物が壁越しでも自動的に追跡されます。敵対Mobがあなたを標的にすると警告が出ます。"
  ],
  "quest.7B2008977702D0C8.quest_subtitle": "RFやFEはどうなった？",
  "quest.520EFA7F446AFBF2.quest_desc": [
    "&3潤滑油&rはドリルビットの作成に使えます。"
  ],
  "quest.7D6B4AEF806AF62E.quest_desc": [
    "100%速すぎます！死なないように！"
  ],
  "quest.495DCA49B4E80852.quest_subtitle": "ピューピュー！",
  "quest.30AD7B15682E4D0E.quest_desc": [
    "任意の量のテキストを保存・表示できるスマート看板です。文字は常に収まるようスケーリングされます。\n\n染料で右クリックすると色を変更でき、枠と背景を別々に着色できます。"
  ],
  "quest.04BE9F63E6003475.title": "LPG",
  "quest.74AE214747A3DB1A.quest_subtitle": "もっと上げよう！",
  "quest.00075A5F9AC120ED.quest_subtitle": "常に必要",
  "quest.63F6F4EBCEB914B0.quest_subtitle": "加圧中！",
  "quest.2AED15E3AC0346FE.quest_subtitle": "とても便利なもの",
  "quest.6674270897997BF7.quest_subtitle": "最大: 1",
  "quest.23737103592776C2.quest_desc": [
    "&3ケロシンランプ&rは燃料(ケロシンが最適)で光る優れた光源です。"
  ],
  "quest.3D819550074CA376.quest_desc": [
    "アイテムは回収される前にここに置く必要があります。"
  ],
  "quest.122EDEC12C9A05D2.quest_desc": [
    "すべてが爆発しうるって言い忘れていましたか？…\n\n幸い簡単な解決策があります！&3セキュリティアップグレード&rをマシンに入れると爆発しなくなります。入れられるマシンすべてに入れましょう。"
  ],
  "quest.61BA2932EC86DA2E.quest_subtitle": "最大: 1",
  "quest.21624A6500545C42.quest_desc": [
    "&3作物サポート&rを作物の上に置くと成長が早くなります。",
    "",
    "{image:atm:textures/questpics/pneumaticcraft/crop_support.png width:200 height:100 align:center}"
  ],
  "quest.4CA17B0A80020B2F.quest_subtitle": "もっと情報が欲しい！",
  "quest.5B9F933ECD6B24FD.quest_subtitle": "最大: 1",
  "quest.42951D14ADCD9332.title": "フィッシュ＆チップス！",
  "quest.15D355EB164EBE68.title": "コンデンサ",
  "quest.54169B69725C49DF.title": "&fプラスチック",
  "task.0B54EDC9E21F2E77.title": "Logistics Frames",
  "quest.3A9AC6AB4407DC32.title": "組み立てラインの使い方",
  "quest.715B86DC82EA636B.quest_desc": [
    "&3液体コンプレッサー&rは特定の液体で圧力を生成します。バケツを右クリックするか、液体をポンプで送るか、GUI上部スロットにバケツを入れます。",
    "",
    "{image:pneumaticcraft:textures/gui/gui_liquid_compressor.png width:200 height:200 align:center fit:true}"
  ],
  "quest.72C09FD89C28B1EC.quest_desc": [
    "&3石油精製機&rは1つの&3精製コントローラー&r(下)と4つの&3精製出力&r(上)で構成される1x1x5のマルチブロックです。油と熱を入力するとディーゼル、ケロシン、ガソリン、LPGが生成されます。側面に&3断熱ラギング&rを付けると保温できます。",
    "",
    "{image:atm:textures/questpics/pneumaticcraft/oil_refinery.png width:300 height:150 align:center}"
  ],
  "quest.7040CA41C0A3C2F2.quest_desc": [
    "&3PCBブループリント&rが今なら8エメラルドで販売中！(期間限定)",
    "{@pagebreak}",
    "(新しいページのプレースホルダーテキスト)"
  ],
  "quest.46BE62C20C720D10.quest_desc": [
    "カボチャランタンのように、エンダーマンが怒らなくなります。"
  ],
  "quest.4E1E31EDD544EE10.quest_subtitle": "64,000mb",
  "quest.2801B7B6BF61E978.quest_subtitle": "ケロシン見たことある？",
  "quest.7BFE7DAF18981843.quest_subtitle": "ドリルのレシピに必要",
  "quest.5D64250B940BC8FD.title": "圧縮鉄の防具",
  "quest.0D50BDEFA0319EA1.quest_subtitle": "常に必要",
  "quest.142C67218BD16867.quest_desc": [
    "この&3ミニガン弾薬&rをミニガンに装填して使います。"
  ],
  "quest.7BFC24607189B6D0.quest_desc": [
    "泳ぐ速度が上がります。"
  ],
  "quest.63F6F4EBCEB914B0.title": "圧力チャンバー",
  "quest.649167FC31EB916E.quest_subtitle": "より良い油",
  "quest.7B2008977702D0C8.quest_desc": [
    "エアコンプレッサーで圧力を作るとき、行き先がないと圧力は消えてしまいます。圧力を作る前に、行き先を確保してください。"
  ],
  "quest.4A076530297F4A97.title": "エレベーター",
  "quest.0FF050EC1EA6EAED.quest_subtitle": "パイプなんて誰が必要？",
  "quest.520EFA7F446AFBF2.quest_subtitle": "潤滑油を生産！",
  "quest.0F49E9167B5E97C9.quest_subtitle": "最大: 1",
  "quest.440B1E1D4951F808.quest_desc": [
    "&3スマートチェスト&rは72スロットの耐爆チェストで、完全設定可能な全方向ホッパー内蔵、アップグレードスロット付き。ラージチェストにはできません。シュルカーボックスのようにも機能します。",
    "{image:atm:textures/questpics/pneumaticcraft/smart_chest_ui.png width:200 height:100 align:center}"
  ],
  "quest.5D7B34761E8FD212.title": "雷からの圧力",
  "quest.5B9F933ECD6B24FD.quest_desc": [
    "ティアIIよりも高くジャンプできます。"
  ],
  "quest.7386A8433698946C.quest_desc": [
    "アイテムを選ぶと、このアップグレードが近くのチェストや地面から探します。チェスト内を探すにはブロックトラッカーアップグレード、地面を探すにはエンティティトラッカーアップグレードが必要です。\n",
    "{image:atm:textures/questpics/pneumaticcraft/item_search_upgrade.png width:200 height:200 align:center}"
  ],
  "quest.2CC56A4F06E53307.quest_subtitle": "サングラスが必要ですね！",
  "quest.187816477B732517.quest_desc": [
    "&3トランスファーガジェット&rはブロック間に置けるホッパーのように機能します。"
  ],
  "quest.602C3E88D96F8843.quest_subtitle": "もう少し！",
  "quest.0D31CD79BE6CC8D2.quest_desc": [
    "なぜ普通のパンには酵母が不要なのでしょう？"
  ],
  "quest.4A076530297F4A97.quest_desc": [
    "この3つのコンポーネントで素晴らしい&3エレベーター&rを作れます。\n",
    "{image:pneumaticcraft:textures/patchouli/elevator.png width:1 height:1 align:left fit:true}"
  ],
  "quest.61B479079DC1C69C.quest_subtitle": "最大: 1",
  "quest.3E16CF590C911129.quest_subtitle": "圧力を感じる",
  "quest.456B9DD108CF340F.quest_desc": [
    "速度を上げます。"
  ],
  "quest.2AED15E3AC0346FE.quest_desc": [
    "以下はこのMODの序盤で使える&3アップグレード&rです。&3アップグレード&rにカーソルを合わせてShiftを押すと使える対象が、アイテムにカーソルを合わせてShiftを押すと使えるアップグレードが表示されます。\n\n注意: サブタイトルはその&3アップグレード&rを入れられる最大数を示します。"
  ],
  "quest.5D64250B940BC8FD.quest_subtitle": "優れたノックバック耐性",
  "quest.6CA01DCE1F4A0EC3.title": "原油",
  "quest.43EF5513A1C52A37.quest_desc": [
    "&3熱空気処理プラント&rは溶融プラスチックの作成に使います。LPG、石炭、熱を送り込むだけです。"
  ],
  "quest.0F49E9167B5E97C9.quest_desc": [
    "落下ダメージ(防具無視)が近くのMobにも与えられます。"
  ],
  "quest.7D6B4AEF806AF62E.quest_subtitle": "最大: 1",
  "quest.39F142224D5210A9.title": "バイオディーゼル",
  "quest.4F5348D0C83C3B0D.quest_desc": [
    "&3ソーラーセル&rはソーラーコンプレッサーの作成に使います。"
  ],
  "quest.3CFE522A4B7CC2EC.quest_desc": [
    "&3強化チェスト&rは36スロットの耐爆チェストです。ラージチェストにはできません。シュルカーボックスのようにも機能します。",
    "{image:atm:textures/questpics/pneumaticcraft/reinforced_chest_ui.png width:200 height:100 align:center}"
  ],
  "quest.6CA01DCE1F4A0EC3.quest_subtitle": "プラスチックへの道",
  "quest.5A0860631323B5E3.quest_subtitle": "これをこねます",
  "quest.04BE9F63E6003475.quest_subtitle": "必要なもの",
  "quest.75D3F3C1D4A3EAA2.quest_desc": [
    "ボルテックスタブの熱を移動するには&3ヒートパイプ&rを作ります。"
  ],
  "quest.6FD65139CD50A8C0.quest_subtitle": "爆破作業に飽きた？",
  "quest.0D9560C8E247F9E7.quest_desc": [
    "どこかを右クリックすると、そこまでの帰り道が分かります。十分近くに直通ルートがあれば経路が表示されます。"
  ],
  "quest.795143471F31A64A.quest_subtitle": "レーザーレシピに必要",
  "quest.02643BAD1AE747C6.quest_desc": [
    "&3アドバンスド液体コンプレッサー&rは液体コンプレッサーと同じですが、はるかに高性能です！"
  ],
  "quest.6CA01DCE1F4A0EC3.quest_desc": [
    "次の段階では&3原油&rの収集が必要です。原油はオーバーワールドの地表で自然に見つかります。"
  ],
  "quest.5303509A1C2B1CCD.quest_desc": [
    "&3ニューマチックジャックハンマー&rは圧力を使って採掘します。アップグレードで素晴らしくなります！"
  ],
  "quest.4B4F5341D6DBDD19.quest_desc": [
    "水中で呼吸でき、泡が5個になると補充されます！水中の視界もずっと良くなります！"
  ],
  "quest.24042326B4632DD4.title": "物流",
  "quest.2CC56A4F06E53307.quest_desc": [
    "空のPCBを&3UVライトボックス&rに入れて充電します。圧力と日光へのアクセスが必要です。",
    "{image:atm:textures/questpics/pneumaticcraft/uv_charging.png width:300 height:150 align:center}"
  ],
  "quest.39F142224D5210A9.quest_subtitle": "バイオ/ディーゼル",
  "quest.7FB12EC3A5888123.quest_desc": [
    "&3チューブジャンクション&rは圧力チューブをより多くの方向へ動かせるようにし、圧力輸送をより細かく制御できます。"
  ],
  "quest.40924F0D64253A38.quest_desc": [
    "アイテムを発射できるようにします。"
  ],
  "quest.00075A5F9AC120ED.quest_desc": [
    "入力チェストからアイテムを取り出します。"
  ],
  "quest.42951D14ADCD9332.quest_subtitle": "フィッシュ＆チップスはいかが？",
  "quest.718DABA6C9E5982A.quest_desc": [
    "装備すると暗視が付与されます。"
  ],
  "quest.1427B3AB09510D20.quest_desc": [
    "未組立PCBにコンデンサ2個とトランジスタ2個を組み合わせて&3完成PCB&rを作ります。"
  ],
  "quest.31BCE63F5E016323.title": "太陽からの圧力",
  "quest.36D72D759C4E8823.quest_desc": [
    "少し速すぎるかもしれません。"
  ],
  "quest.0D31CD79BE6CC8D2.quest_subtitle": "あなたの問題の酵母",
  "quest.3A9AC6AB4407DC32.quest_subtitle": "組み立てが必要",
  "quest.0AEAEA976ED0C470.quest_desc": [
    "&3充電ステーション&rは圧力を使って&aPneumaticCraft&rの各種ツールやガジェットを充電します。"
  ],
  "quest.0FF050EC1EA6EAED.quest_desc": [
    "&3液体ホッパー&rは液体用のホッパーです。パイプの代わりにはなりません。"
  ],
  "quest.657DB994B029F61C.quest_desc": [
    "&3ヒートフレーム&rを特定の液体が入った容器に付け、十分冷やすと液体がアイテムに変わります。\n\n溶融プラスチック→プラスチック\n水→氷\n溶岩→黒曜石"
  ],
  "quest.4CA17B0A80020B2F.quest_desc": [
    "&3圧力計&rはマシンの追加情報を表示します。"
  ],
  "quest.75D3F3C1D4A3EAA2.quest_subtitle": "熱を移動させます :)",
  "task.1EEC7B67E037F766.title": "圧力の理解",
  "quest.7040CA41C0A3C2F2.quest_subtitle": "Amadronに感謝！",
  "quest.4F5348D0C83C3B0D.title": "ソーラーセル",
  "quest.65E2AF881709C896.quest_subtitle": "たくさん必要になります",
  "quest.423B8DA485C1308C.title": "ガソリン",
  "quest.5AEE86EB39FD4087.quest_desc": [
    "&3ボルテックスタブ&rは圧力を熱気と冷気に分離します。冷気は青側、熱気は赤側に流れます。"
  ],
  "quest.4FCC20D9F8F87B2F.quest_subtitle": "ツールの話をしよう！",
  "quest.312331F6DB0CE5F4.quest_subtitle": "最大: 1",
  "quest.24042326B4632DD4.quest_desc": [
    "物流を始めるには&3ロジスティクスコア&rをクラフトします。使い方の完全なチュートリアルはPNC:Rマニュアルを読むことをおすすめします。"
  ],
  "quest.5A9D6672385D3D82.quest_desc": [
    "アップグレードに必要なラピスが4個ではなく1個で済みます。"
  ],
  "task.2C268116DA162155.title": "AllRightsReserved",
  "quest.31BCE63F5E016323.quest_subtitle": "私の手のひらの中で…",
  "quest.440B1E1D4951F808.quest_subtitle": "チェスト界のオタク",
  "quest.0CC48C2AA553A314.quest_desc": [
    "&3ドリルビット&rはニューマチックジャックハンマーに使用できます。"
  ],
  "quest.5103C817381181DE.quest_desc": [
    "ニューマチックチェストプレートを着けたままエリトラを使えます。"
  ],
  "quest.7770F0D62457096D.title": "ドローンのプログラミング",
  "quest.52D3697F1F5625C7.quest_desc": [
    "&3エッチング酸&rは圧力チャンバーで溶融プラスチックなどから作られます。エッチングタンクで使用します。"
  ],
  "quest.2745297337E13E9E.quest_subtitle": "もう旧式のエアコンプレッサーは不要！",
  "quest.5303509A1C2B1CCD.quest_subtitle": "ごめんね、ジャック！",
  "quest.4C0D00B5305117A1.quest_subtitle": "ピューピュー(あなたなしで)",
  "quest.5D64250B940BC8FD.quest_desc": [
    "圧縮鉄は&3圧縮鉄の防具&rの作成に使えます。鉄の防具と同じですが、防具強度とノックバック耐性が優れています。\n\nクラフトでも入手できますが、戦利品チェストでもよく見つかります。"
  ],
  "quest.15007DCAF701B361.quest_desc": [
    "チェストプレートの貯蔵エネルギーから、インベントリ内の他の加圧可能アイテムを充電します。"
  ],
  "quest.7177E49BF9ECA5CF.title": "熱からの圧力",
  "quest.74015945716FD10A.quest_desc": [
    "&3全方向ホッパー&rはどの面からでもアイテムを取り込め、アップグレードで通常ホッパーよりずっと速くなります！パイプが不要なときに便利です。"
  ],
  "quest.371A34B297C8A8EF.quest_subtitle": "空気の力",
  "quest.61BA2932EC86DA2E.quest_desc": [
    "とても高くジャンプできます。"
  ],
  "quest.520EFA7F446AFBF2.title": "潤滑油",
  "quest.15007DCAF701B361.quest_subtitle": "最大: 6",
  "quest.2C5D78630C7AD57F.quest_subtitle": "もっと近くへ！",
  "quest.5E71F8A046C60346.quest_subtitle": "圧力 = 電力",
  "quest.5C7D9BCDF19B86BD.quest_desc": [
    "爆発を防ぎます。"
  ],
  "quest.52D3697F1F5625C7.quest_subtitle": "聞かないで…",
  "quest.132DF9ECEFFB3B71.quest_desc": [
    "&3モジュール拡張カード&rは充電モジュールをさらに強化します。"
  ],
  "quest.5AEE86EB39FD4087.quest_subtitle": "まだRFではない…",
  "quest.42951D14ADCD9332.quest_desc": [
    "マッシュドピーとトーストに乗せた豆も一緒にいかがですか、ガバナー？"
  ],
  "quest.53518D4ED99A242F.quest_desc": [
    "&3カモフラージュアプリケーター&rはPneumaticCraftの機械を他のブロックに隠せます。"
  ],
  "quest.371A34B297C8A8EF.title": "PneumaticCraft: Repressurized",
  "quest.6FD65139CD50A8C0.quest_desc": [
    "それって可能なの？\n\n自動化するなら&eProductive Bees&rや&aMystical Agriculture&rが使えます。まあ…爆発でも自動化できますが。"
  ],
  "task.25FF884779D98BAD.title": "建築用レンガ™",
  "quest.2AED15E3AC0346FE.title": "シンプルなアップグレード",
  "quest.24042326B4632DD4.quest_subtitle": "アイテム/液体の輸送",
  "quest.762B8309E1A31B99.quest_subtitle": "最大: 4",
  "quest.74AE214747A3DB1A.quest_desc": [
    "アイテムが保持できる圧力を増やします。"
  ],
  "quest.230463E830D6FFEB.quest_subtitle": "PCBへの道",
  "quest.0D2F5CC96269F9E3.quest_desc": [
    "PCB作成の次の段階は&3エッチングタンク&rでエッチング液を使います。稼働には熱が必要です。"
  ],
  "quest.3F9CCCFEF4E84166.quest_desc": [
    "熱生産を増やすには、ボルテックスタブの冷側に&3ヒートシンク&rを付けます。"
  ],
  "quest.2E8F851A4E98F741.quest_desc": [
    "&3ニューマチックアーマー&rはそれだけでも優秀ですが、素晴らしいものにするにはアップグレードが必要です。デフォルトではUキーでアップグレードGUIを開きます。圧力を使うものと使わないものがあります。\n\n他のツールと同様、&3ニューマチックアーマー&rのアップグレードには圧力入りの充電ステーションが必要です。\n\n注意: サブタイトルはそのアップグレードを入れられる最大数を示します。"
  ],
  "quest.187816477B732517.quest_subtitle": "小型ホッパー",
  "quest.718DABA6C9E5982A.quest_subtitle": "最大: 1",
  "quest.13F68CA518CD287C.quest_desc": [
    "&3ディーゼル&rはケロシンを増やしたり、潤滑油を作ったりできます。"
  ],
  "quest.681A3F31FB242555.title": "エタノール",
  "quest.312331F6DB0CE5F4.quest_desc": [
    "ティアIより高速です。"
  ],
  "quest.30AD7B15682E4D0E.quest_subtitle": "看板？聞いたことないな！",
  "quest.7FB12EC3A5888123.quest_subtitle": "いや、こっちだ！",
  "quest.6D124ACF4AE80490.quest_subtitle": "遠くから爆発を発射！",
  "quest.15D355EB164EBE68.quest_subtitle": "完成PCBに必要",
  "quest.371A34B297C8A8EF.quest_desc": [
    "PneumaticCraftは圧力がすべてです！これらのクエストはMODのすべてを網羅していませんが、多くを説明します！JEIを見て、ツールチップを読み、PNC:Rマニュアルを読んでください。すべて非常に役立ちます。\n\n始めるには&3圧縮鉄インゴット&rが必要です！最も簡単な方法は地面に穴を掘り、鉄インゴット(またはブロック)を投げ入れ、TNTで爆破することです！\n\n爆発で一部失われるかもしれませんが、それは受け入れるべきリスクです！"
  ],
  "quest.6EB53CDCB80D4B66.quest_desc": [
    "&3ニューマチックドア&rは自分だけが開けられる自動ドアとして機能します！",
    "",
    "{image:pneumaticcraft:textures/patchouli/pneumatic_door.png width:200 height:200 align:right fit:true}"
  ],
  "quest.649167FC31EB916E.quest_desc": [
    "&3植物油&rは作物か種を&3熱空気処理プラント&rに入れると作れます。"
  ],
  "quest.5D71ED16FD4E725A.quest_desc": [
    "ピグリンが中立的になります(金の防具と同じ効果)。アップグレードは1箇所に入れるだけでOKです。"
  ],
  "quest.3F9CCCFEF4E84166.quest_subtitle": "より多くの熱",
  "quest.43EF5513A1C52A37.title": "熱空気処理",
  "quest.2745297337E13E9E.quest_desc": [
    "&3アドバンスドエアコンプレッサー&rはエアコンプレッサーと同じですが、はるかに高性能です！"
  ],
  "quest.23737103592776C2.quest_subtitle": "メガトーチなんて目じゃない！",
  "quest.13F68CA518CD287C.quest_subtitle": "Poor Sel",
  "quest.3A9AC6AB4407DC32.quest_desc": [
    "すべてのレシピが同じ部品を必要とするわけではありませんが、&3組み立てライン&rには全部品を設置できます。すべてに使えるシンプルな構成を下の画像に示します。\n\n各部品のクエストで重要な情報を確認してください。\n\nスピードアップグレードで大幅に速くなります！"
  ],
  "quest.32C3E14578D48E6C.quest_subtitle": "アップグレード圧力チューブ",
  "quest.72C09FD89C28B1EC.title": "石油精製機",
  "quest.456B9DD108CF340F.quest_subtitle": "スピーディ！",
  "quest.649167FC31EB916E.title": "植物油",
  "quest.423B8DA485C1308C.quest_desc": [
    "&3ガソリン&rはLPGの原料になります。"
  ],
  "quest.5103C817381181DE.quest_subtitle": "最大: 1",
  "quest.21624A6500545C42.quest_subtitle": "作物の成長促進",
  "quest.64D34A6C3487C5DF.quest_desc": [
    "&3エアリアルインターフェース&rは加圧可能なアイテムに圧力を補充できます。これでニューマチックアーマーを充電なしで使えます！\n\n&6ATMスター&rのクラフトにも必要です。"
  ],
  "quest.43CDC28DC56BB3E2.quest_subtitle": "128,000mb",
  "quest.65E2AF881709C896.title": "強化石",
  "quest.61B479079DC1C69C.quest_desc": [
    "ティアIより高くジャンプできます。"
  ],
  "quest.7A50F12255EEF123.title": "まだここにはない"
}
