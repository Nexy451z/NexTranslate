{
  "quest.0A497EC17534D248.quest_desc": [
    "&#53BAEDBBL Routers&rは完全ワイヤレスの物流MODです。&#8B53EDインポーター&rと&#EDB753エクスポーター&rがあれば、アイテム、液体、電力、化学物質、ソースを転送できます。"
  ],
  "quest.0A497EC17534D248.title": "&#45A5EDBBL Routersへようこそ",
  "quest.33A1316FD66C6428.quest_subtitle": "インポーター／エクスポーターを動作させるにはアップグレードが必要です",
  "quest.3584DE12E1D7D14F.quest_desc": [
    "このMODには2種類のフィルターがあり、手に持った状態で&7右クリック&rすると設定できます:",
    "",
    "1. &#EDDE53MODフィルター&r: 設定するには、MODの正式名称をスペースなしで入力する必要があります。",
    "",
    "2. &#EDDE53タグフィルター&r: 設定するには、タグを#なしで入力する必要があります。"
  ],
  "quest.3584DE12E1D7D14F.title": "フィルターアップグレード",
  "quest.3E14842D5F454F98.title": "動作速度の向上",
  "quest.401A518B2D1BDB9A.quest_subtitle": "受け取り側のインベントリに設置する",
  "quest.5312BD7BDC054E48.title": "アイテムの転送",
  "quest.548676DCD1E09A7F.quest_subtitle": "送り側のインベントリに設置する",
  "quest.6420E8B38993D8E3.title": "電力伝送",
  "quest.671141CF874D89A4.title": "液体の転送",
  "quest.68ABBA8CB99AF6A1.quest_desc": [
    "アイテムにカーソルを合わせて&#EDD353Shift&rを押すと、そのアイテムに関する情報が表示されます。",
    "",
    "&#537CEDコネクター&rを使うには、まず&#EDB553インポーター&rを&7右クリック&rし、次に&#5360EDエクスポーター&rを&7右クリック&rしてリンクさせます。"
  ],
  "quest.7742D896461A4632.quest_subtitle": "エクスポーターに入れるだけ"
}
