  ],
  "quest.36541A2179A7E76B.quest_subtitle": "ブレイズビーにベニトアイト鉱石を与える",
  "quest.3AF30E1EC163E2E3.quest_subtitle": "ダイヤモンドミツバチにサファイアを与える",
  "quest.516289A040EE9FDC.quest_subtitle": "クリスタライン + ネオンカッコー",
  "quest.2FE088899C1AF39B.quest_subtitle": "合金製錬機で作成",
  "quest.00A17728A387B426.quest_subtitle": "オーバーワールドのどこでも使用可",
  "quest.7C169A4A39F37FAC.quest_desc": [
    "バニラの蜂の巣を使って&eアドバンスドハイブ&rをクラフトします。オークでも他の木材でも構いません。\n\nミツバチが出入りし、インベントリにハニカムを落とします。ガラス瓶を入れるとハチミツのボトルも得られます。\n\nトリート用にハニカムが大量に必要です！"
  ],
  "quest.6E4C3B87FABE9EFA.quest_subtitle": "銅/スズのミツバチの卵に溶融青銅をかける",
  "quest.196E55B64667AE35.quest_desc": [
    "下の画像のように、ハイブの前に設置した給餌スラブの上にミツバチ用の花を置けます。\n",
    "{image:atm:textures/questpics/bees/feeder.png width:175 height:100 align:center fit:true}"
  ],
  "quest.2C29683DA28A8D47.quest_subtitle": "再処理機で作成",
  "task.34C16667CDF3E53A.title": "銅のミツバチ",
  "quest.160BD0185954C891.quest_desc": [
    "ハニートリートの代わりに、このハイブはミツバチをおびき寄せるのに金インゴットを必要とします。"
  ],
  "quest.33422FBDAE11AE82.title": "フルイックスミツバチ",
  "quest.24888CAD50B32B04.quest_subtitle": "石の巣から出現",
  "quest.114D668C691A2BDF.quest_subtitle": "アッシュマイニング + クリスタリン",
  "quest.2A559D527BC88DEC.quest_desc": [
    "&9スペーシャルミツバチのスポーンエッグ&rと&8スカイスチールブロック&rを溶岩に投げ込むと、スカイスチールミツバチのスポーンエッグができます。"
  ],
  "quest.7AE1459B0B862737.quest_subtitle": "ただクラフトするだけ",
