  "quest.01F7F3589EBD8872.quest_subtitle": "シュルームビーに茶色のキノコを与える",
  "quest.371E09ED2A3F6BDC.title": "ゾンビー",
  "quest.6F7AC41B703028CC.quest_subtitle": "銅/銀のミツバチの卵に溶融シグナルムをかける",
  "task.4FCEB24FC83D22A9.title": "コンスタンタン ハニカム",
  "task.3CDFAF37BFB1C89C.title": "イエローカーペンターミツバチ",
