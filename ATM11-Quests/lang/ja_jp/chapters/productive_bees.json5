  "task.429FA8057B666565.title": "ラピスハニカム",
  "quest.003AA945CACCD641.quest_subtitle": "供え物のテーブルで作成",
  "quest.16987C41D4F5BA47.quest_subtitle": "合金製錬機で作成",
  "quest.198EDBAC1D6E2339.quest_desc": [
    "エンダーミツバチにはこれが必要です"
  ],
  "quest.70C878DB6AE413B2.quest_subtitle": "マグマティック + 石炭",
  "quest.7941938014E97A30.quest_desc": [
    "ミツバチに乗って飛びたいと思ったことはありませんか？\n\nバンブルビーは自然に世界にスポーンし、乗り物として使えます！\n\n&6ステッキのおやつ&rを作り、バンブルビーにサドルをつけて空へ飛び立ちましょう！"
  ],
  "quest.33A0E06FE5CFD8F3.quest_desc": [
    "&9遠心分離機&rはミツバチのコームを有用なアイテムとハチミツに処理します！最初は普通の&9遠心分離機&rで構いませんが、すぐに&6電動遠心分離機&rを導入しましょう。電力で動く高速な遠心分離機です！\n\nコームを処理する最良の方法を求めるなら、&c加熱遠心分離機&rはさらに高速で、コームではなく&aコームブロック&rを処理します！\n\nこれらは速度アップグレードでさらに高速化できます。"
  ],
  "quest.010A970FC91BD617.quest_subtitle": "合金製錬機で作成",
  "task.6D4F62833424ADC0.title": "アイアンハニカム",
  "quest.3157BD833FCE8CD3.quest_subtitle": "溶岩ミツバチにシェオルファイアのバケツを与える",
  "quest.5372264ED2D55143.quest_subtitle": "石炭ミツバチの卵を工業的に絞る",
  "quest.4FE7F45C72EF5DC1.title": "ニッケルミツバチ",
  "quest.5CC9CB0911954215.quest_subtitle": "オーバーワールドのどこでもミツバチをおびき寄せる",
  "quest.74B3E4B62FA9565E.quest_subtitle": "供え物のテーブルでクラフト",
  "quest.76E94639E90FEB4E.title": "スケルタルビー",
  "quest.728189EE56E5CAF7.quest_subtitle": "合金製錬機で作成",
  "quest.39A19138C501B16F.title": "スライミービー",
  "quest.7B5A0BFD47D96BDE.quest_desc": [
    "周囲を飛び回るミツバチを捕まえるのに使います。\n\nフィルターアップグレードで捕まえるミツバチを絞り込め、BaBeeアップグレードでベビーミツバチのみ捕獲できます。"
  ],
  "quest.26FB7A789981BD3C.quest_subtitle": "石炭ミツバチにグラファイトブロックを与える",
  "quest.150FB369BEFFCBBF.quest_subtitle": "銀/スズのミツバチのスポーンエッグに溶融ルミウムをかける",
  "quest.3E301F3EEC8C763A.quest_desc": [
    "ベビーミツバチの成長を早めたり、新しいスポーンエッグを作ったりできます。\n\nケージ入りのベビーミツバチとハニートリート20個を置くと成虫になります。\n\nスポーンエッグを作るには、欲しいミツバチの遺伝子とハニートリートを組み合わせ、そのハニートリートを卵と一緒にこのマシンで使います。\n\n遺伝子は最大100%の純度まで合成でき、卵をミツバチのスポーンエッグに変換する確率が100%になります。",
    "{@pagebreak}",
    "ケージから出さずに遺伝子を適用することもできます。ケージ入りのミツバチと、適用したい遺伝子サンプル入りのハニートリートをインキュベーターに入れます。"
  ],
  "quest.369D3AF332181DA8.quest_desc": [
    "石の巣はオーバーワールドのどのバイオームでも設置でき、メイソンビーかディガービーをおびき寄せます。"
  ],
  "quest.2AEC294578952BFD.quest_subtitle": "ラピス + スケルタル",
  "task.6887F86C8673DAF6.title": "リードミツバチ",
  "quest.0A11725B41AB45F6.quest_desc": [
    "このクエストは&6AllTheModsスタッフ&rまたは&2コミュニティ貢献者&rがAllTheMods MODパック用に作成したものです。\n\nすべての&6AllTheMods&rパックは&eAll Rights Reserved&rライセンスのため、このクエストは&6AllTheModsチーム&rがリリースしたもの以外の公開パックで、明示的な許可なく使用できません。\n\nこのクエストは意図的に非表示です。表示されているなら編集モードです。"
  ],
  "task.4203F7ED807F3D30.title": "スケルタルハニカム",
  "quest.37367101B3DAA70F.quest_subtitle": "土の巣から出現",
  "quest.6E819CCD57B15D54.quest_desc": [
    "ファウンドリを使い、&#4CE688溶融ビブラニウム&rを&#F2EB2Eオールザモディウムミツバチのスポーンエッグ&rに注ぎます。"
  ],
  "quest.05F8458AB4A6950B.quest_subtitle": "ダイヤモンドミツバチにヴォイドシマーグーを与える",
  "quest.39A19138C501B16F.quest_desc": [
    "沼地バイオームでスライミーの巣を使うとこのミツバチをおびき寄せられます。"
  ],
  "quest.15C9CCCC8E06D430.quest_subtitle": "クリスタリンミツバチにブラッククォーツブロックを与える",
  "quest.54CBCD9D2F1AD907.quest_subtitle": "ダイヤモンドミツバチに秘術クリスタルブロックを与える",
  "task.0EF1CA8DED2FF38C.title": "アドバンスドミツバチハイブ",
  "quest.114D668C691A2BDF.title": "鉄のミツバチ",
  "quest.0D97CDE92F3B1A83.quest_subtitle": "鉛/ダイヤモンド/プラチナミツバチの卵に溶融エンデリウムをかける",
  "quest.6F978C4D561F35EC.quest_desc": [
    "ボトラーには2つの用途があります: ハチミツの瓶詰めと、遺伝子を得るためのミツバチ潰しです。\n\nミツバチから遺伝子を得るには、ボトラーの上に1ブロック分の空間を空けてピストンを設置します。\n\nボトラーの上にミツバチを置き、ピストンを作動させてミツバチを潰して遺伝子にします。できた潰れたボトルは遠心分離機に入れられます。\n\n注意: ボトラーには瓶を入れておいてください。",
    "{image:atm:textures/questpics/bees/bottler.png width:100 height:150 align:1}"
  ],
  "quest.1D995548A159F291.quest_subtitle": "ゴーストリービーにソウリウムダガーを与える",
  "quest.7C169A4A39F37FAC.title": "アドバンスドハイブ",
  "quest.6DBF9CAB37B9BBF3.quest_subtitle": "ミツバチの生産性を120%向上",
  "quest.37367101B3DAA70F.quest_desc": [
    "アッシュマイニングビーは土、砂利、または砂の巣から出現します。"
  ],
  "task.181135E3A83C5B9E.title": "亜鉛ハニカム",
  "quest.019CC48531E7759B.quest_subtitle": "ドラゴンスチールフォージで作成",
  "quest.3567306F2B66BD20.quest_subtitle": "注入クラフト",
  "quest.40E4F1172A164DD1.title": "シュガーバッグビー",
  "quest.7941938014E97A30.quest_subtitle": "オーバーワールドのバンブルビーの巣から出現",
  "quest.371E09ED2A3F6BDC.quest_subtitle": "暗い場所の空のアドバンスドハイブに出現",
  "task.2EA19C4E46380CDA.title": "ルビーハニカム",
  "quest.037FBF06E59E1027.quest_subtitle": "クリバノで作成",
  "quest.7941938014E97A30.title": "バンブルビー",
  "quest.041CDB45450A67E0.quest_subtitle": "プラチナミツバチの卵と古代ミツバチの卵を合金化",
  "quest.29EE878BC8D3A742.title": "ミツバチを捕獲！",
  "quest.57ACD83205988834.title": "プラチナミツバチ",
  "task.4471A530B55D4140.title": "オスミウムハニカム",
  "quest.32FDC5FFA000DAF8.quest_desc": [
    "自分のミツバチを誇りに思っていますか？\n\n瓶に入れて見せびらかしたくありませんか？\n\nミツバチジャーを設置し、パイプかホッパーでケージ入りのミツバチをジャーに入れます。"
  ],
  "quest.17419401147B5C02.quest_subtitle": "ミツバチとミツバチ",
  "quest.399882F3C51DD282.title": "ウィザードビー",
  "quest.1A0672C7509271B3.quest_subtitle": "ダイヤモンドミツバチにフルオライトを与える",
  "quest.196E55B64667AE35.quest_subtitle": "スラブを設置",
  "quest.486060882E507CF1.quest_subtitle": "土の巣から出現",
  "quest.0E345B5B625E6235.quest_subtitle": "エンチャンティングアパラタスでクラフト",
  "quest.18F948FF9FE015FB.title": "クリービー",
  "quest.13AA91D39A2CABF2.quest_desc": [
    "&6Productive Bees&rへようこそ！\n\nMODを始めるには、まずハニカムとハチミツのボトルを入手しましょう！蜂の巣を見つけて、しばらくミツバチに働いてもらいます。満タンになったらシアリングでハニカムが、ガラス瓶でハチミツのボトルが得られます！\n\n&9重要な注意&r: ハニカムを必要とするミツバチクエストでは、レシピが表示されません。必要な場合はJEIで調べてください！"
  ],
  "quest.3D7480E4F9063E93.quest_subtitle": "ランバー + スウェット",
  "quest.5894A9DB9C379E91.quest_subtitle": "注入クラフト",
  "quest.47CEFA06392C4211.quest_subtitle": "ミツバチの収容量を増やす",
  "quest.6EFFF0DC80C1C8A3.quest_desc": [
    "ファウンドリを使い、&#F2EB2E溶融オールザモディウム&rを&#944A12エンシェントミツバチのスポーンエッグ&rに注ぎます。"
  ],
  "quest.79D6A251FE3761B3.quest_subtitle": "沼地バイオームでスライミービーをおびき寄せる",
  "quest.57ACD83205988834.quest_subtitle": "金 + エンダー",
  "quest.309059DEDEE7AECD.title": "ホーダービー",
  "quest.003AA945CACCD641.title": "深海のミツバチ",
  "quest.003FF3813A864BA1.title": "ストレンジマターミツバチ",
  "quest.010A970FC91BD617.title": "ソウラリウムミツバチ",
  "quest.019CC48531E7759B.title": "アイスドラゴンスチールミツバチ",
  "quest.035495984F84FB44.title": "脈動合金ミツバチ",
  "quest.037FBF06E59E1027.title": "デオルムミツバチ",
  "quest.041CDB45450A67E0.title": "デュラチウムミツバチ",
  "quest.0465094C2D31B898.title": "ウラニナイトミツバチ",
  "quest.05422E444126FDA6.title": "クリムゾンアイアンミツバチ",
  "quest.05428EA120583BD0.title": "ニトロクリスタルミツバチ",
  "quest.05F8458AB4A6950B.title": "セレスティジェムミツバチ",
  "quest.065196033249A0AA.title": "バイオスチールミツバチ",
  "quest.0691BDE968724213.title": "ヴァイブラント合金ミツバチ",
  "quest.06B352AE90DD0D3E.title": "インフィニティのミツバチ",
  "quest.06B6786122F3DAF9.quest_desc": [
    "ミツバチが働ける時間帯に影響します。3つのレベルがあります: &a昼行性&r、&d夜行性&r、&cメタターナル&r。&a昼行性&rは昼間のみ、&d夜行性&rは夜間のみ、&cメタターナル&rは一日中働けます。狙いは&cメタターナル&rです。ビービーは元から&cメタターナル&r特性を持っています。&a&l生産性&rのクエストで触れたとおり、このミツバチはジ・アザーにいて、特に危険です。\n\nその危険なミツバチを避けたいなら別の方法があります。夜間にミツバチをフェンスにつないで&d夜行性&rにし、そのミツバチを昼間にフェンスの外に出すと&cメタターナル&rになります。ゴーストリービーやシュルームビー(元から&d夜行性&r)を使えば片方の手順を省略できます。"
  ],
  "quest.06B6786122F3DAF9.quest_subtitle": "睡眠は弱者のもの",
  "quest.06B6786122F3DAF9.title": "&e&l行動",
  "quest.08A3292277D2FDE2.title": "水エッセンスミツバチ",
  "quest.0AF2460579C6BD8C.title": "精製黒曜石ミツバチ",
  "quest.0B2210804594E7B8.title": "秘術エッセンスミツバチ",
  "quest.0BCB7E97BC566683.title": "マンガンミツバチ",
  "quest.0CD6F30BBEE20E15.title": "精製グロウストーンミツバチ",
  "quest.0E345B5B625E6235.title": "土エッセンスミツバチ",
  "quest.101E3A21FEE00E3F.title": "エナジャイトミツバチ",
  "quest.104BF57D4A006688.title": "スカルクミツバチ",
  "quest.10DF9DE4B6C03D6B.title": "汚染された金ミツバチ",
  "quest.128A14A3842325FE.quest_desc": [
    "アドバンスドハイブに取り付けると、ミツバチは物理的に巣の外に出なくなります。花ブロックへの移動はシミュレートされます。\n\n必要な花ブロック、またはハイブ内のミツバチに必要な花ブロックやアイテムを入れた給餌スラブをハイブの前に設置してください。正しい設定方法は給餌スラブのクエストを確認してください。\n\nミツバチが消えず、ハイブへの出し入れも簡単になるので強くおすすめします。"
  ],
  "quest.13C5C06278DD9C95.title": "アダマントミツバチ",
  "quest.13CAD46F4B229AB4.title": "注入鉄ミツバチ",
  "quest.1404BB8956D5F8C7.quest_desc": [
    "ミツバチが悪天候下で働ける能力に影響します。3つのレベルがあります: &aなし&r、&d雨&r、&c全天候&r。狙いは&c全天候&rです。雷雨時にフェンスにつないでもいいですが、さすがに酷です。\n\nもっと簡単な方法を紹介します。釣りです。そう、ミツバチは釣れます。ウォータービーやプリズマリンビーは元から全天候耐性を持っています。これを利用しましょう！"
  ],
  "quest.1404BB8956D5F8C7.quest_subtitle": "大物の中では一番小さいやつ",
  "quest.1404BB8956D5F8C7.title": "&9&l天候耐性",
  "quest.15288215A4BA2596.title": "ローズクォーツミツバチ",
  "quest.1540A9CDE2ED77E8.title": "スピリテッドクリスタルミツバチ",
  "quest.15C9CCCC8E06D430.title": "ブラッククォーツミツバチ",
  "quest.16987C41D4F5BA47.title": "銅合金ミツバチ",
  "quest.170C31F3BAF050BC.title": "ブルトニウムミツバチ",
  "quest.176ACC61DC206E55.quest_desc": [
    "Crimson Forestで見つかるミツバチです。巣はクリムゾンファンガスを育てると2%の確率で得られます。"
  ],
  "quest.177199FED92C3B5B.title": "次元ミツバチ",
  "quest.17A322C3B309A4D4.title": "レガリウムミツバチ",
  "quest.17B18040EFA37F86.title": "消耗した放射性ミツバチ",
  "quest.1A0672C7509271B3.title": "フルオライトミツバチ",
  "quest.1A4FAE5705B53753.title": "風エッセンスミツバチ",
  "quest.1ACB3EDBCB732514.title": "モナザイトミツバチ",
  "quest.1B79F794EDAA810A.quest_desc": [
    "繁殖チャンバーは2匹のミツバチを自動で繁殖させます。自己繁殖も、2種類のミツバチから3種類目を作ることもできます(例: アッシュマイニング + クリスタリン → 鉄)。競合する場合(先の例でアッシュマイニング + クリスタリン → アルミニウム)、どちらかのミツバチを一度取り出して戻してください。\n\n各スロットに繁殖アイテム(通常は花。特定のミツバチを入れたケージを持ってSHIFTを押すと使用アイテムを確認できます。例: ドラコニックビーはドラコニックダスト2個)とミツバチケージを入れます。\n\nただし…F.Bee.I.に狙われるようなことはしないでください。もし狙われたら、あなたを恥辱の殿堂に確実に追加しますからね。"
  ],
  "quest.1B79F794EDAA810A.quest_subtitle": "赤ちゃん作り2: エレクトリック・ビーガルー",
  "quest.1C0F4D1610530FEC.title": "ファイアドラゴンスチールミツバチ",
  "quest.1C40B30823B2A254.title": "プリズマリンミツバチ",
  "quest.1D995548A159F291.title": "ソウリウムミツバチ",
  "quest.1DC407272D9D9CCE.title": "覚醒スプリミウムミツバチ",
  "quest.205DE46ABA1CCC8F.title": "導電合金ミツバチ",
  "quest.2086C73688C8BA51.title": "硫酸ミツバチ",
  "quest.21FDF07571B5DCA7.title": "フェリコアミツバチ",
  "quest.22647504C37E547C.title": "シアナイトミツバチ",
  "quest.22CF5AD56C1BB8D5.title": "ダークジェムミツバチ",
  "quest.23820B0DCEC022D1.title": "プラスチックミツバチ",
  "quest.24846776077B52C3.title": "スプリミウムミツバチ",
  "quest.24B147D251D0CFFF.title": "ブレイズゴールドミツバチ",
  "quest.26B3AE1E77A84BCB.title": "スカイオスミウムミツバチ",
  "quest.26B9909717528D5E.title": "ウセリックミツバチ",
  "quest.26FB7A789981BD3C.title": "グラファイトミツバチ",
  "quest.28AE3B536D23E138.title": "インフェリウムミツバチ",
  "quest.2982D38BD5EE6349.quest_desc": [
    "Warped Forestで見つかるミツバチです。巣はワープドファンガスを育てると2%の確率で得られます。"
  ],
  "quest.29A71E780923874E.title": "シリコンミツバチ",
  "quest.2AEEDCC6826CF4AB.title": "オイリーミツバチ",
  "quest.2C29683DA28A8D47.title": "インサナイトミツバチ",
  "quest.2E0275C21D3F0DA3.quest_desc": [
    "ドラコニックビーと混同しないでください。"
  ],
  "quest.2E0275C21D3F0DA3.quest_subtitle": "ワイバーンフュージョンクラフト",
  "quest.2E0275C21D3F0DA3.title": "ドラコニウムミツバチ",
  "quest.2F2597122C6202EF.title": "プロメテウムミツバチ",
  "quest.2FE088899C1AF39B.title": "ダークスチールミツバチ",
  "quest.30A238E87F013CBB.quest_desc": [
    "ミツバチにはさまざまな特性があり、働き方、働く時間帯、攻撃性、攻撃時に針を失う確率に影響します。このクエストでは、最良の特性を手に入れる方法とその使い方を説明します。\n\nこれらの遺伝子サンプルを入手するには、このクエストの前提であるボトラーのクエストを確認してください。遺伝子サンプルを実際にミツバチに適用するには、クラフトグリッドでハニートリートと組み合わせます。タイプ以外のすべての特性は、ハニートリートを与えることでミツバチに適用できます。タイプは仕組みが異なり、インキュベーターで該当するミツバチのスポーンエッグを作る必要があります。"
  ],
  "quest.30A238E87F013CBB.quest_subtitle": "究極のミツバチを作るために",
  "quest.30A238E87F013CBB.title": "遺伝子サンプル",
  "quest.3157BD833FCE8CD3.title": "シェオルファイアミツバチ",
  "quest.31ED0C236C41A837.title": "溶岩ミツバチ",
  "quest.3466C70EB256026B.title": "火エッセンスミツバチ",
  "quest.3567306F2B66BD20.title": "インペリウムミツバチ",
  "quest.35FE9C3395491433.title": "圧縮鉄ミツバチ",
  "quest.36324B10F09E9EDA.quest_subtitle": "ほとんどの木の巣から出現",
  "quest.36324B10F09E9EDA.title": "グリーンカーペンタービー",
  "quest.36541A2179A7E76B.title": "ベニトアイトミツバチ",
