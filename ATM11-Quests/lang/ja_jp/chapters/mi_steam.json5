{
  "quest.06F02863E2F74144.title": "ここにはまだない",
  "quest.088CA7B6D4899846.quest_desc": [
    "&#65C2A6パッカー&rは、&#53E67Bダブルインゴット&r、&#53E67Bブレード&r、&#53E67Bケーブル&rの作成に使用します。このマシンには他にも多くの用途がありますが、当面はこれらが主な使い道となるでしょう。"
  ],
  "quest.0DAF5D42694EA8C9.quest_desc": [
    "&#6E6D6D&nフォージハンマー&rはあなたの旅の始まりです。鉱石から&#B53A3Aより良い産出&rを得たり、今後のクラフトに必要な&#DBD25A部品&rを作ったりと、多くの用途があります。",
    "",
    "クラフトした&7ハンマー&rはレシピには必須ではありませんが、&#DBD25A部品&rをクラフトする際により良い産出が得られます。"
  ],
  "quest.0DAF5D42694EA8C9.title": "&#949494フォージハンマー",
  "quest.1036837C9AD3F301.quest_desc": [
    "&#6E6D6Dフォージハンマー&rを使えば、&#FFAC3B銅&rのインゴットや鉱石を簡単に粉へと粉砕できます。"
  ],
  "quest.12F9705ACB8FB300.quest_desc": [
    "&#EDD653&n切断マシン&rを使えば多くのクラフトが可能になります。特に重要なのはボルトです。 ",
    "",
    "&#EDD653&n切断マシン&rは&#E3993D潤滑剤&rと共に使用します。潤滑剤は&#EDD653&nミキサー&rで入手できます。"
  ],
  "quest.12FB3990CA1653A4.quest_desc": [
    "&#DBA15A蒸気ドリル&rは序盤の採掘における最高の相棒です。&53x3&rの範囲を採掘でき、&#EEF768切り替え可能なシルクタッチ&rも備えています。",
    "",
    "&53x3&r採掘の切り替えは、デフォルトで&7'Y'&rに設定されている「Toggle 3x3 Mining」キーバインドを押すことで行えます。",
    "",
    "&#EEF768シルクタッチ&rは、蒸気ドリルを&7スニーク＋右クリック&rすることで切り替えられます。",
    "",
    "&#DBA15A蒸気ドリル&rを補充するには、インベントリ内の&6燃料&rの上でドリルを持って&7右クリック&rします。&9水&rはワールド内で&7右クリック&rするか、水入りバケツを持ち歩くことでも補充できます。"
  ],
  "quest.1C9D3FC67D58AC02.quest_desc": [
    "&#EDD653&nミキサー&rを使うと、アイテムと液体を組み合わせることができます。アイテムの染色や複製にも使用できます。"
  ],
  "quest.1E4E462928F2A71C.quest_desc": [
    "&7&nコークス炉&rは&#787777石炭&rを&#696464コークス&rに変換するために使います。&#696464コークス&rは燃料として&#787777石炭&rの4倍の効果があります。 ",
    "",
    "オフハンドかメインハンドに&#D1D15Eレンチ&rを持ってマルチブロックをプレビューできます。&#B4D95Dハッチ&rを手に持つと、設置可能な位置が表示されます。",
    "",
    "&7&nコークス炉&rは主にレンガで構成された中空のマルチブロックです。"
  ],
  "quest.21A4FE1741E4E78C.quest_desc": [
    "&#65C2A6クアリー&rは資源を生成するマルチブロックです。動作には&aドリル&rと&7蒸気&rが必要です。",
    "",
    "稼働のたびに&aドリル&rを消費する可能性があります。より良い&aドリル&rほど良い資源が得られます。",
    "",
    "蒸気クアリーで使用できるのは&#DEA14B銅&rと&#DE9531青銅ドリル&rのみです。また&#8A5C1E土&rを使って石を生成することもできます。"
  ],
  "quest.21A4FE1741E4E78C.quest_subtitle": "無限の資源",
  "quest.23708582B1064C9D.quest_desc": [
    "&#46DBBB回路&rを動作させるには、これらの基本部品がいくつか必要です。これらの一部を自動化しておくと、将来役に立ちます。"
  ],
  "quest.23708582B1064C9D.title": "静電容量と抵抗",
  "quest.24285F25F9563B02.quest_desc": [
    "&#467FDB&nアナログ回路&r、ああ、ついに完成させましたね。普通の人なら半分の時間で作れるところですが、とがめはしません…"
  ],
  "quest.24285F25F9563B02.quest_subtitle": "電子工学の基礎",
  "quest.253822C64BBBB1EB.quest_desc": [
    "&#6E6D6Dフォージハンマー&rを使えば、&#9AD5ED錫&rのインゴットや鉱石を簡単に粉へと粉砕できます。"
  ],
  "quest.357DDE894EB512F7.quest_desc": [
    "&#65C2A6ワイヤーミル&rは、ちょうど良い力加減で&#53E67Bワイヤー&rを作り出します。衝撃的ですよね!! わかります…"
  ],
  "quest.3AA4D1B60E4E71A5.quest_desc": [
    "すべての&cマルチブロック&rは、内部に設置された&eハッチ&rによって性能が決まります。&cマルチブロック&r内の&eハッチ&rをアップグレードすると、マシン全体がアップグレードされます。"
  ],
  "quest.41877F44CD3D1EDB.quest_desc": [
    "&#E3BC19青銅かまど&rは通常のかまどとまったく同じように動作しますが、大きな違いは蒸気で動くことと、速度が2倍であることです。"
  ],
  "quest.458BFDB636F8B495.quest_desc": [
    "コークスの粉と鉄を組み合わせると、未焼成の鋼の粉ができます。これを蒸気溶鉱炉で焼くと、今後の進行に必要な鋼インゴットが得られます。"
  ],
  "quest.478C1AF86610A8B7.quest_desc": [
    "&#EDD653&nコンプレッサー&rは&#53EDAA板&r、&#53EDAA湾曲板&r、&#53EDAAリング&rの作成に使用します。"
  ],
  "quest.48F77A0BE1F33B29.quest_desc": [
    "新たに建設した&#65C2A6ワイヤーミル&rを使えば、&#53E67Bワイヤー&rと&#53E67B細いワイヤー&rを作れるようになり、電気の時代へと進めます。"
  ],
  "quest.48F77A0BE1F33B29.title": "恐るべきワイヤー",
  "quest.4E69C6ABFE467C25.quest_desc": [
    "&#65C2A6合金精錬炉&rは&#3187C4Extended Industrialization&rのマシンです。&#4C4BDEミキサー&rと&#954BDEかまど&rの役割を1つにまとめており、作業をより手軽にしてくれます。"
  ],
  "quest.55C6BBC996B51838.quest_desc": [
    "&#ED9553青銅ボイラー&rは&9水&rを蒸気に変換します。蒸気は&7&n蒸気時代&rにマシンを動かすための燃料として機能します。",
    "",
    "使用するには、&9水&rと任意の&#ED5353かまどの燃料&rを供給するだけです。これによりマシンの温度が上がり、最高温度では4台のマシンを同時に動かせます。"
  ],
  "quest.55C6BBC996B51838.quest_subtitle": "水を沸かそう",
  "quest.589DFDB8FB7211AA.quest_desc": [
    "&#C1DB46&n電気時代&rへ進むための&7ゴム&rの生産は簡単です。早い段階で自動化しておけば、あなたが思う以上に先へ進めます。"
  ],
  "quest.589DFDB8FB7211AA.title": "ゴムと回路基板",
  "quest.5CCF92238B23EDC9.quest_desc": [
    "&#A0DE45&nModern Industrialization&rは、その性質上&#D93D3DIC2&rや&#D93D3DGregTech&rに似たMODですが、この2つとは異なる進め方が必要です。",
    "",
    "これらのクエストを通して、&#E8C843AllTheMods Star&r、そして後に&#43E898Infinity Armor&rに必要な部品の作り方を案内します。"
  ],
  "quest.5CCF92238B23EDC9.quest_subtitle": "読むと役に立ちます",
  "quest.5CCF92238B23EDC9.title": "&#A0DE45Modern Industrializationへようこそ",
  "quest.5E191081662C2F1A.quest_desc": [
    "&#6E6D6Dフォージハンマー&rは、&#A0DE45Modern Industrialization&rの村人の仕事台ブロックとして機能します。この村人は多種多様な有用な取引を提供してくれます。"
  ],
  "quest.68EAB0248989FC97.quest_desc": [
    "&#EDD653&n蒸気溶鉱炉&rは新たな進行の地平を開きます。今後の活動において重要なマルチブロックとなるでしょう。",
    "",
    "このマルチブロックでは&7鋼インゴット&rを作れるだけでなく、&#696E60未精製合成油&rを&#494D43合成油&rに処理できます。合成油は後に&#36472Aゴム&rやその他のものに使われます。"
  ],
  "quest.7282DCB1547CEB63.quest_desc": [
    "&#ED9553青銅&rは&7&n蒸気時代&rの基礎となる素材です。この粉を焼くことで&#ED9553青銅インゴット&rが得られ、以降で使用します。"
  ],
  "quest.7282DCB1547CEB63.title": "&#EDD653青銅",
  "quest.7A873E48E38B5C0E.quest_desc": [
    "鋼製マシンは青銅製の2倍の蒸気を消費しますが、その代わり速度も2倍になります。"
  ],
  "quest.7D220876E8FF7AED.quest_desc": [
    "&#65C2A6アンパッカー&rには多くの用途があり、&#53E67Bブロックをインゴットに分解&rしたり、&#53E67Bマシンの部品をリサイクル&rしたりできます。",
    "",
    "&oシリコンインゴットもより簡単に入手できます。&r"
  ]
}
