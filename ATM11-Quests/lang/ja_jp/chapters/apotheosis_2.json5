{
  "quest.4F7F8F4ED1CA0550.quest_desc": [
    "スポナーに焚き火を使用すると、モブが炎上した状態でスポーンします。ステーキを作るのに最適です"
  ],
  "quest.167E1474644C9908.quest_desc": [
    "クォーツは、他のアイテムの効果と逆の効果をスポナーに与えます。オフハンドにクォーツ、メインハンドに他のスポナー改造アイテムを持つと、そのアイテムの逆の効果が発生します。クォーツとブレイズロッドを使うと、スポーン範囲を増やす代わりに減らします。クォーツとガストの涙を使うと、最大エンティティ数が減少します"
  ],
  "quest.7A9AE63998BB41FF.title": "最小スポーン遅延",
  "quest.4D07B0A4A2E77CDA.quest_desc": [
    "スポナーが保持できるモブの最大数です。最大6体の場合、6体がすでにスポーンしていると、それらが死んだり移動するまで新たにはスポーンしません。ガストの涙を使うと、エンティティ数を2ずつ増減できます。最大16体、最小1体です"
  ],
  "quest.18E0F5A78F696FA3.title": "残響",
  "quest.7A9AE63998BB41FF.quest_desc": [
    "スポナーがモブをスポーンするタイミングは、最大と最小のスポーン遅延時間の間でランダムに決定されます。最小遅延は100から32,767まで設定可能です。インゴットを使うと、10ずつ増減します"
  ],
  "quest.186593EBCE3FE8D8.title": "スポーン範囲",
  "task.39702880D9133E3E.title": "羊毛",
  "quest.18E0F5A78F696FA3.quest_desc": [
    "残響の欠片はスポナーに特別な効果を与えます。スポーンしたモブがドロップするアイテムが倍増します"
  ],
  "quest.0E02CE4469FCA4C9.quest_desc": [
    "レッドストーンアクティベーションは、スポナーにオン/オフスイッチを提供します。レッドストーンパワーがなければ、スポーンしません"
  ],
  "quest.30EB438C66324213.quest_desc": [
    "コンジットは、プリズマリンシャードと同じことをしますが、これはより優れています。プレイヤーがスポナーの近くにいる必要はもうありません。そのチャンクがロードされていれば、スポーンします"
  ],
  "quest.4F7F8F4ED1CA0550.title": "燃焼",
  "quest.6F71FD826C29C31A.title": "若返り",
  "task.73B56F2139A98F77.title": "AllRightsReserved",
  "quest.0D6D45DBA64E612D.quest_desc": [
    "最大スポーン遅延は、モブがスポーンするまでの最長時間です。最小遅延と同じく、100から32,767まで設定できます。インゴットを使うと、10ずつ増加します。これはマインクラフトのティックで、20ティックが1秒に相当します。したがって、最速のスポーン遅延は各5秒です"
  ],
  "quest.0F89BFD4A3F63A48.quest_desc": [
    "一部のモブ（主にモンスター）は、スポーンするために特定の光レベルが必要です。敵対的なものは低いレベルを、受動的なものは高いレベルを必要とします。ソウルランタンを使用すると、光レベルを気にする必要がなくなります！これは、家畜が草を必要とするなど、他のスポーン要件を無視するわけではありません。ドラゴンエッグによっても無視されるものです"
  ],
  "quest.40096ED0B04C3EC5.title": "すべての条件を無視",
  "quest.30EB438C66324213.title": "プレイヤーを無視",
  "quest.42D7C8CD8E6F5CD7.title": "AIなし",
  "quest.6A497B063CF32A5C.quest_desc": [
    "ピグリッチの心は、その名の通りピグリッチによってドロップされます。スポナーからスポーンできるモブの数を増やすために使用できます。スポーンされるモブはランダムで、ピグリッチの心によって最大数が決まります。ハート1つにつき1増減し、最大で8までです"
  ],
  "quest.4D07B0A4A2E77CDA.title": "最大エンティティ数",
  "quest.1AD87CB3226ED224.title": "静かに、モブを起こさないで！",
  "quest.186593EBCE3FE8D8.quest_desc": [
    "スポーン範囲は、モブがスポーンするエリアです。エリアが広ければ広いほど、スポーンする場所が増えます。エリアが狭ければ狭いほど、工場はコストが抑えられます"
  ],
  "quest.42D7C8CD8E6F5CD7.quest_desc": [
    "スポナーにコーラスフルーツを使用すると、スポーンされるモブの魂を吸い取り、かつての姿の空っぽの殻だけが残ります。モブはすべてのAIを失うので、アーマースタンドのようにほとんど動きません。攻撃もできず、テレポートもできず、自力で動くこともありません。ただそこに座って、殺されるのを待っているのです。なんとスリリングなことでしょう！"
  ],
  "quest.310969B8FE0A94DE.quest_desc": [
    "Apotheosisがもたらすゲームの仕様変更は、スポナーに関するものです。シルクタッチでスポナーを採掘できたことを覚えていますか？Apotheosisのおかげでそれが戻ってきました！これらのアイテムを右クリックすることで、スポナーに多くの新しい変更を加えることができます"
  ],
  "quest.3E2A411FF5B4B0E7.title": "アクティベーション範囲",
  "quest.7F6B66566C211735.quest_desc": [
    "スポナーに 鍾乳石を使用すると、スポーンするモブの最大体力が減少します。体力を20%まで減らすことができます"
  ],
  "quest.1AD87CB3226ED224.quest_desc": [
    "羊毛はスポナーに対して一つのことしかしません。それは、うるさいスポナーの音を消すことです。スポナーの騒音が嫌なら、羊毛を使いましょう！どんな色でも、糸の本数でも、デザインでも構いません！"
  ],
  "task.3B219688DA1CF9C8.title": "AllRightsReserved",
  "quest.2FE4B7B70D90A455.quest_desc": [
    "これらのクエストは &6AllTheModsスタッフ &rまたは &2コミュニティ寄与者 &rによって AllTheModsモッドパック 内での使用目的のために作成されました。\\n\\nすべての&6AllTheMods&rパックは &eAll Rights Reserved &r（著作権留保）ライセンス下のため、これらのクエストは &6AllTheModsチーム &rにより公式に配布されていない公開パッケージにおいて、明示的な許可なく本クエストを使用することは禁止されています。\\n\\nこのクエストは意図的に非表示になっています。クエストが見えている場合は編集モードになっています。"
  ],
  "quest.6A497B063CF32A5C.title": "スポーン数",
  "quest.0E02CE4469FCA4C9.title": "レッドストーンアクティブ",
  "quest.310969B8FE0A94DE.title": "モンスタースポナー",
  "quest.3E2A411FF5B4B0E7.quest_desc": [
    "アクティベーション範囲は、プレイヤー（あなた）がスポナーに近づかなければならない距離です。最小は1ブロック離れたところから、最大は48ブロック離れたところまでです。これらはスポナーの周りを円で囲むようにしていて、直接ブロックではありません。コンジットとドラゴンの卵はこれらを無視します"
  ],
  "quest.167E1474644C9908.title": "逆の日",
  "quest.40096ED0B04C3EC5.quest_desc": [
    "すべてのスポナーに必要なものです。すべての条件を無視すると言うとき、ほとんどの条件を無視します。光レベル、スポーンに必要なブロック、バイオームを無視します。ただし、スライムが3x3のエリアを必要とするなどの空間条件は必要ですし、プレイヤーが近くにいる必要があるのも同様です"
  ],
  "quest.0F89BFD4A3F63A48.title": "光を無視",
  "quest.0D6D45DBA64E612D.title": "最大スポーン遅延",
  "quest.6F71FD826C29C31A.quest_desc": [
    "以前のバージョンから戻ってきた方には新しいかもしれません。スポナーにタートルエッグを使用すると、その中のモブは赤ちゃんバージョンのみをスポーンします。これはバニラの赤ちゃんバージョンのモブにのみ機能し、MODで追加されたものには効果がありません"
  ],
  "quest.7F6B66566C211735.title": "体力",
  "quest.00C26068B55F4FD9.quest_desc": [
    "沈黙のルーンがスポナーに対してできることはただ一つ、その音を黙らせることだけだ。スポナーのうるさい音を聞くのが嫌なら、沈黙のルーンを使おう！"
  ],
  "quest.00C26068B55F4FD9.title": "静かにしないとモブが起きちゃうぞ！",
  "quest.0E90577AC72749C4.quest_desc": [
    "&a轟雷のスポナーアップグレードルーン&rは、スポナーアップグレードルーンの第4、そして最終段階であり、スポナーを最高のポテンシャルへと引き上げる。\n\n最小および最大スポーン遅延は20、スポーン数は16、最大エンティティ数は32、発動範囲は48に設定される。\n\nエンダーサージジェムはジ・エンドで入手できる。"
  ],
  "quest.0F0E227FC3EC0D90.quest_desc": [
    "これらはApothic Spawners以外のMODが提供するスポナーだ。"
  ],
  "quest.1102B27CBF564127.quest_desc": [
    "スポナーアジテーターはここに挙げた他の改造アイテムとは違い、Apothic SpawnersではなくPneumaticCraftが提供するものだ。ModpackにApothic Spawnersが入っていない場合、スポナーにアジテーターを付けるとプレイヤーがどこにいてもモブをスポーンさせるようになる。Apothic Spawnersがある場合（もちろんこのModpackにはある）、それは変わらないが、チャンクから離れてもスポーンしたモブがデスポーンしないようになる。"
  ],
  "quest.1102B27CBF564127.quest_subtitle": "モブよ、勝手にデスポーンするなよ",
  "quest.17410BE15A81DD96.quest_desc": [
    "&a旅人のスポナーアップグレードルーン&rはスポナーアップグレードルーンの第2段階だ。\n\n最小スポーン遅延は100、最大スポーン遅延は400、スポーン数は10、最大エンティティ数は18、発動範囲は32に設定される。\n\nこのルーンのクラフトにはどのスポーンエッグでも使える。"
  ],
  "quest.17C87EB8ED8A27AB.quest_desc": [
    "スポナールーンはスポナーを改造するための基本素材だ。"
  ],
  "quest.17C87EB8ED8A27AB.quest_subtitle": "基本的な改造",
  "quest.21C2458FED19363C.quest_desc": [
    "&aエッセンス&rと、モブ収監ツールに入れたモブを使い、そのモブのコピーをスポーンさせる。"
  ],
  "quest.21C2458FED19363C.quest_subtitle": "Industrial Foregoingのスポナー",
  "quest.223A5BDB5056B781.quest_desc": [
    "キャプチャリングは剣用のエンチャントで、モブがまれにエッグをドロップするようになる。レアなエンチャントなので、見つかるまで探し続けよう。&5&lApothic Enchanting&rも参考にしてほしい。レベルごとにキル時に0.5%の確率でエッグを入手でき、通常入手できる最高レベルはVII（7）だ。"
  ],
  "quest.263860CADB3D76C6.quest_desc": [
    "パワードスポナーはEnderIOで作るモブスポナーだ。まず、中身の入ったソウルバイアルと壊れたスポナーが必要になる。（厳密にはスポナーを変更するにはソウルバイアルだけでいいのだが、まあいいだろう）。気に入った壊れたスポナーが手に入ったら、それでパワードスポナーをクラフトしよう！あとは設置してキャパシターを入れ、電力を供給する。これでEnderIOでモブをスポーンさせられるぞ。\n\nこのスポナーはクリッカーなしで直接ソウルバイアルを充填することもできる。"
  ],
  "quest.263860CADB3D76C6.quest_subtitle": "EnderIOのスポナー",
  "quest.2D8A7065F8CDDDDD.quest_desc": [
    "スワブはスポーンエッグを入手する私のお気に入りの方法だ。これにはMob Grinding Utilsを使う必要がある。モブにスワブを右クリックしてから、それと種、任意の&aXPフルイド&rのバケツでチキンフィードをクラフトしよう。どの種類の&aXPフルイド&rを使っても構わない。それができたら、ニワトリに与える。残念ながらニワトリはこの手順で死んでしまうが、スポーンエッグが手に入る！\n\nただし、すべてのモブにスワブを使えるわけではない。"
  ],
  "quest.321C15EBBE2D3D30.quest_desc": [
    "スポナーを爆破すると、スポナーは非常に不安定になり、対応するモブを大量にスポーンさせ、スポナーチェーンを残す。\n\nチェーンがいくつ残るか気になるだろうか？執筆時点では48〜57個だ。\n\nこれらのチェーンはこんなものに必要になる……"
  ],
  "quest.321C15EBBE2D3D30.title": "スポナーを爆破する",
  "quest.39E822440E7D2E04.quest_desc": [
    "Mob Grinding UtilsはモブファーミングのためのMODなので、もちろんスポナーもある！エンティティスポナーだ！ただし動作には3つのものが必要になる：スポーンエッグ、XPゼリーベイビー、そしてレッドストーン信号だ。XPゼリーベイビーは、XPをXPモールド ゼリーベイビーとともにXP固化装置で処理することで作られる。そのまま食べることも、2番目のスロットで燃料として使うこともできる。上スロットにスポーンエッグ、2番目にXPゼリーベイビーを入れ、レッドストーン信号を与えれば、モブのスポーンが始まる！"
  ],
  "quest.39E822440E7D2E04.quest_subtitle": "Mob Grinding Utilsのスポナー",
  "quest.3F1430ADB648102F.quest_desc": [
    "このスポナールーンは他のものとは動作が異なる。スポナーの1つのステータスに影響するのではなく、複数を同時に変化させる。また、毎回増減させるのではなく、それらのステータスを特定の値に設定する。\n\n&a開拓者のスポナーアップグレードルーン&rはスポナーアップグレードルーンの第一段階であり、最も安価で、当然ながら最も弱い。\n\n最小スポーン遅延は150、最大スポーン遅延は600、スポーン数は7、最大エンティティ数は12、発動範囲は24に設定される。",
    "{@pagebreak}",
    "スポナーがいつスポーンするかは、最大スポーン遅延と最小スポーン遅延の間でランダムな数値を選んで決定される。速さはティックで表され、20ティック＝1秒だ。\n\nスポーンするモブはランダムで、最大数はスポーン数によって決まる。\n\n最大エンティティ数は、スポナーがスポーンさせて維持できるモブの数だ。例えば最大エンティティ数が6で、すでに6体のモブがスポーンしている場合、それらが死ぬか移動するまで新たにスポーンしない。\n\n発動範囲は、スポナーが動作するためにプレイヤー（あなた）がどれだけ近くにいなければならないかを示す。"
  ],
  "quest.3F55F3CC8519D783.quest_desc": [
    "ソウリウムスポナーはMystical Agricultureから贈られたスポナーだ。モブエッセンスとエネルギーを使ってモブをスポーンさせる。モブエッセンスは、ソウルジャーで作られるモブプラントを収穫して得られる。つまり、まずモブを倒すか、ソウルエクストラクターを使う必要がある。"
  ],
  "quest.3F55F3CC8519D783.quest_subtitle": "Mystical Agricultureのスポナー",
  "quest.503AC506720FC59E.quest_desc": [
    "スポナーをより高度に改造するには、スポナールーンを&d&l注入&rする必要がある。\n\n&5エンチャントテーブル&rで少なくとも&aエターナ70&r、&cクォンタ30%&r、&5アルカナ50%&rが必要だ。\n\nそれを実現するには、以下のいずれかを使う：\n\n&9ドープシェルフ&r14個（&9休眠状態&rでないもの！）\n&4グローイングヘルシェルフ&r12個と&9ドープシェルフ&r2個！\n&bクリスタリンシーシェルフ&r12個と&9ドープシェルフ&r2個！\n\nこれらの仕組みについて詳しくは&5&lApothic Enchanting&rの章を参照。"
  ],
  "quest.503AC506720FC59E.quest_subtitle": "高度な改造",
  "quest.52FAF122466FDDC9.quest_desc": [
    "スタビライズドスポナーはDraconic Evolution版のスポナーだ。スポナーにコアを使用すると、スタビライズドスポナーになる。コアは交換できるが、ステータスはコアによって設定されるため変更できない。上位のコアほど、より多くのモブがより速いペースでスポーンする。"
  ],
  "quest.52FAF122466FDDC9.quest_subtitle": "Draconic Evolutionのスポナー",
  "quest.6D3B958E49AE7BDB.quest_desc": [
    "チャームフラグメントはチャームかスポーンエッグのどちらかに加工できる。Reliquaryのアイテムで、対応するモブからまれにドロップする。中にはクラフトできるものもある！2個と普通のエッグでスポーンエッグをクラフトできる。"
  ],
  "quest.6D68D9941049E806.quest_desc": [
    "このスポナーは名前の通り、燃料として&dソース&rを利用する。スポーンさせるモブを決めるには、そのモブを収めた封じ込めジャーを範囲内に置く必要がある。"
  ],
  "quest.6D68D9941049E806.quest_subtitle": "Ars Nouveauのスポナー",
  "quest.72AE56D34834D28E.quest_desc": [
    "またPneumaticCraftか？ああ、今度はれっきとしたスポナーだな。Draconicのスタビライズドスポナーと同様、まずバニラのスポナーが必要だ。入手したら、スポナーの上にスポナー抽出器を置き、-0.5バール以下を与えると動作する。完了すると、中にいたモブが入ったスポナーコアが手に入り、空のスポナーが残る。次に空のスポナーで加圧スポナーをクラフトし、スポナーコアを入れる。（コアをアップグレードするには、バキュームトラップでモブを吸い込み、スポナーコアに入れる）。これでスポナーは圧力で動作し、明るさを無視し、レッドストーンで起動するようになる。"
  ],
  "quest.72AE56D34834D28E.quest_subtitle": "PneumaticCraftのスポナー",
  "quest.76A3A2A97AB66C43.quest_desc": [
    "&9永遠の封印の箱&rに閉じ込めた復讐のスピリットからスポーンエッグを作りたい？\n\n&9スピリットリアニメーター&rがまさにそれを行ってくれる。大量の&c血液&rとエッグ、そしてスポーンエッグの元にしたいスピリットが入った&9永遠の封印の箱&rを渡すと、スポーンエッグの作成を試みてくれる！\n\n注意：一部のモブはスポーンエッグの作成に使用できない。"
  ],
  "quest.77A8E8122870BBCE.quest_desc": [
    "これは厳密にはスポーンエッグではないが、モブをスポナーに紐付けられる能力があるため、ここで紹介しておく。このリードの入手方法について詳しくは&5&lApothic Enchanting&rの章を参照。"
  ],
  "quest.77A8E8122870BBCE.quest_subtitle": "これはスポーンエッグじゃない！",
  "quest.78E94C386B1E7359.quest_desc": [
    "通常スポーンエッグは入手できないが、スポナーも同じはずなのにこうして存在している！スポーンエッグの入手方法はいくつかあるが、入手したらスポナーに右クリックしてスポーンするモブを変更しよう。"
  ],
  "quest.7AC6A958936636D9.quest_desc": [
    "&a登山者のスポナーアップグレードルーン&rはスポナーアップグレードルーンの第3段階だ。そう、これにはウォーデンと戦う必要がある。\n\n最小スポーン遅延は50、最大スポーン遅延は200、スポーン数は13、最大エンティティ数は24、発動範囲は40に設定される。"
  ]
}
